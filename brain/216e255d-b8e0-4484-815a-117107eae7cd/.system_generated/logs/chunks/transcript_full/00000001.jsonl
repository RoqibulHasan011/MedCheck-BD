     phone: '+8801511000013',\n        email: 'rajshahi@wellness.com',\n        address: 'Shaheb Bazar, Rajshahi',\n        area: 'Rajshahi',\n        division: 'Rajshahi',\n        licenseNumber: 'DL-RAJ-2024-0091',\n        verified: false,\n        status: 'Pending',\n        openingHours: '8:00 AM - 10:00 PM',\n        isOpenNow: true,\n        userId: pharmacyOwner1._id,\n      },\n    ];\n\n    const createdPharmacies = await Pharmacy.create(pharmaciesData);\n    console.log(`[Seed] Created ${createdPharmacies.length} pharmacies across Bangladesh.`);\n\n    // 5. Populate Inventories for Pharmacies\n    const inventoryData = [];\n    const mainPharmacy = createdPharmacies[0]; // MedCare Pharmacy\n    const secondPharmacy = createdPharmacies[1]; // Lazz Pharma\n    const thirdPharmacy = createdPharmacies[2]; // Tamanna Pharmacy\n\n    // Populate MedCare Pharmacy with comprehensive stock\n    createdMedicines.forEach((med, idx) => {\n      const medBatches = createdBatches.filter((b) => String(b.medicineId) === String(med._id));\n      const activeBatch = medBatches[0] || null;\n\n      // Price variations for demonstration\n      let sellingPrice = med.referencePrice;\n      if (idx % 3 === 0) sellingPrice = Number((med.referencePrice + 0.30).toFixed(2));\n      else if (idx % 3 === 1) sellingPrice = Number(med.referencePrice.toFixed(2));\n      else sellingPrice = Number((med.referencePrice - 0.20).toFixed(2));\n\n      // Quantity variations (low stock for idx === 2)\n      let quantity = 50;\n      if (idx === 2) quantity = 4; // LOW STOCK\n      if (idx === 5) quantity = 0; // OUT OF STOCK\n\n      if (activeBatch) {\n        inventoryData.push({\n          pharmacyId: mainPharmacy._id,\n          medicineId: med._id,\n          batchId: activeBatch._id,\n          quantity,\n          purchasePrice: Number((med.referencePrice * 0.85).toFixed(2)),\n          sellingPrice,\n        });\n      }\n    });\n\n    // Populate second pharmacy (Lazz Pharma) with stock\n    createdMedicines.slice(0, 15).forEach((med, idx) => {\n      const medBatches = createdBatches.filter((b) => String(b.medicineId) === String(med._id));\n      const activeBatch = medBatches[0];\n      if (activeBatch) {\n        inventoryData.push({\n          pharmacyId: secondPharmacy._id,\n          medicineId: med._id,\n          batchId: activeBatch._id,\n          quantity: 35 + (idx * 5),\n          purchasePrice: Number((med.referencePrice * 0.83).toFixed(2)),\n          sellingPrice: Number((med.referencePrice + (idx % 2 === 0 ? 0.20 : 0)).toFixed(2)),\n        });\n      }\n    });\n\n    // Populate third pharmacy (Tamanna Mirpur)\n    createdMedicines.slice(0, 10).forEach((med) => {\n      const medBatches = createdBatches.filter((b) => String(b.medicineId) === String(med._id));\n      const activeBatch = medBatches[0];\n      if (activeBatch) {\n        inventoryData.push({\n          pharmacyId: thirdPharmacy._id,\n          medicineId: med._id,\n          batchId: activeBatch._id,\n          quantity: 20,\n          purchasePrice: Number((med.referencePrice * 0.84).toFixed(2)),\n          sellingPrice: med.referencePrice,\n        });\n      }\n    });\n\n    const createdInventory = await Inventory.create(inventoryData);\n    console.log(`[Seed] Created ${createdInventory.length} inventory records with dynamic price variances.`);\n\n    // 6. Create Sample Sales and Receipts\n    const sampleSale = await Sale.create({\n      receiptId: 'MC-2026-784102',\n      pharmacyId: mainPharmacy._id,\n      customerId: customerUser._id,\n      customerName: customerUser.name,\n      customerPhone: customerUser.phone,\n      items: [\n        {\n          medicineId: createdMedicines[0]._id,\n          medicineName: createdMedicines[0].name,\n          genericName: createdMedicines[0].genericName,\n          batchNumber: 'NAPA-2026-01',\n          quantity: 20,\n          unitPrice: 1.20,\n          totalPrice: 24.00,\n        },\n        {\n          medicineId: createdMedicines[4]._id,\n          medicineName: createdMedicines[4].name,\n          genericName: createdMedicines[4].genericName,\n          batchNumber: 'SEC-2026-01',\n          quantity: 14,\n          unitPrice: 6.00,\n          totalPrice: 84.00,\n        },\n      ],\n      subtotal: 108.00,\n      discount: 8.00,\n      totalPrice: 100.00,\n      paymentMethod: 'bKash',\n      date: new Date(Date.now() - 1000 * 60 * 60 * 24 * 2), // 2 days ago\n    });\n\n    console.log('[Seed] Created sample digital sale receipt:', sampleSale.receiptId);\n\n    // 7. Create Customer Medicine History\n    await MedicineHistory.create([\n      {\n        customerId: customerUser._id,\n        medicineId: createdMedicines[0]._id,\n        medicineName: createdMedicines[0].name,\n        genericName: createdMedicines[0].genericName,\n        manufacturer: createdMedicines[0].manufacturer,\n        batchNumber: 'NAPA-2026-01',\n        verificationStatus: 'DATABASE MATCH',\n        pharmacyId: mainPharmacy._id,\n        pharmacyName: mainPharmacy.name,\n        type: 'VERIFICATION',\n        checkedAt: new Date(Date.now() - 1000 * 60 * 60 * 48),\n      },\n      {\n        customerId: customerUser._id,\n        medicineId: createdMedicines[4]._id,\n        medicineName: createdMedicines[4].name,\n        genericName: createdMedicines[4].genericName,\n        manufacturer: createdMedicines[4].manufacturer,\n        batchNumber: 'SEC-2026-01',\n        verificationStatus: 'PURCHASED',\n        pharmacyId: mainPharmacy._id,\n        pharmacyName: mainPharmacy.name,\n        type: 'PURCHASE',\n        notes: 'Purchased with digital receipt MC-2026-784102',\n        checkedAt: new Date(Date.now() - 1000 * 60 * 60 * 24 * 2),\n      },\n      {\n        customerId: customerUser._id,\n        medicineId: createdMedicines[6]._id,\n        medicineName: createdMedicines[6].name,\n        genericName: createdMedicines[6].genericName,\n        manufacturer: createdMedicines[6].manufacturer,\n        batchNumber: 'MAX-2026-01',\n        verificationStatus: 'DATABASE MATCH',\n        type: 'VERIFICATION',\n        checkedAt: new Date(Date.now() - 1000 * 60 * 60 * 12),\n      },\n    ]);\n\n    // 8. Create Sample Suspicious Medicine Reports\n    await Report.create([\n      {\n        reportId: 'RPT-2026-1042',\n        customerId: customerUser._id,\n        customerName: customerUser.name,\n        customerPhone: customerUser.phone,\n        medicineName: 'Ace Plus',\n        genericName: 'Paracetamol + Caffeine',\n        manufacturer: 'Square Pharmaceuticals PLC',\n        batchNumber: 'ACE-FLAG-88',\n        pharmacyName: 'Local Corner Drugstore',\n        pharmacyLocation: 'Mirpur 11, Dhaka',\n        issueType: 'Suspected Counterfeit',\n        description: 'The blister pack foil text was slightly smudged and tablets had an unusual powdery residue.',\n        status: 'Under Investigation',\n        adminNotes: 'Notified quality assurance division for sample cross-referencing.',\n        createdAt: new Date(Date.now() - 1000 * 60 * 60 * 72),\n      },\n      {\n        reportId: 'RPT-2026-1088',\n        customerId: customerUser2._id,\n        customerName: customerUser2.name,\n        customerPhone: customerUser2.phone,\n        medicineName: 'Seclo 20 mg',\n        genericName: 'Omeprazole',\n        manufacturer: 'Square Pharmaceuticals PLC',\n        batchNumber: 'SEC-OLD-2024',\n        pharmacyName: 'Unregistered Vendor',\n        pharmacyLocation: 'Mohakhali Bus Stand',\n        issueType: 'Expired Medicine',\n        description: 'Sold expired strip with scratched-out manufacturing date stamp.',\n        status: 'Pending Review',\n        createdAt: new Date(Date.now() - 1000 * 60 * 60 * 24),\n      },\n    ]);\n\n    // 9. Create Access Logs\n    await AccessLog.create([\n      {\n        userEmail: 'admin@medcheckbd.com',\n        userRole: 'admin',\n        action: 'LOGIN',\n        resourceType: 'Auth',\n        details: