 const resultContainer = document.getElementById('verifyResultArea');\n41:   const searchBtn = document.getElementById('verifySearchBtn');\n42: \n43:   if (!resultContainer) return;\n44: \n45:   if (searchBtn) {\n46:     searchBtn.disabled = true;\n47:     searchBtn.innerHTML = '<span class=\"spinner-border spinner-border-sm me-2\"></span>Checking records...';\n48:   }\n49: \n50:   resultContainer.innerHTML = `\n51:     <div class=\"text-center py-5\">\n52:       <div class=\"spinner-border text-primary\" style=\"width: 3rem; height: 3rem;\" role=\"status\"></div>\n53:       <p class=\"mt-3 text-muted fw-bold\">Cross-referencing MedCheck BD Reference Database...</p>\n54:     </div>\n55:   `;\n56: \n57:   try {\n58:     const token = localStorage.getItem('token');\n59:     const headers = { 'Content-Type': 'application/json' };\n60:     if (token) headers.Authorization = `Bearer ${token}`;\n61: \n62:     const res = await fetch(`/api/verify/${encodeURIComponent(query)}`, { headers });\n63:     const data = await res.json();\n64: \n65:     if (!data.success || !data.matchFound) {\n66:       renderNotFoundResult(query, data);\n67:       return;\n68:     }\n69: \n70:     renderMatchResult(data);\n71:   } catch (err) {\n72:     resultContainer.innerHTML = `\n73:       <div class=\"alert alert-danger shadow-sm border-0\" role=\"alert\">\n74:         <i class=\"fas fa-exclamation-triangle me-2\"></i> Verification query failed: ${err.message}\n75:       </div>\n76:     `;\n77:   } finally {\n78:     if (searchBtn) {\n79:       searchBtn.disabled = false;\n80:       searchBtn.innerHTML = '<i class=\"fas fa-search me-2\"></i>Verify Medicine';\n81:     }\n82:   }\n83: }\n84: \n85: function renderNotFoundResult(query, data) {\n86:   const resultContainer = document.getElementById('verifyResultArea');\n87:   resultContainer.innerHTML = `\n88:     <div class=\"card border-0 shadow-lg\" style=\"border-radius: 16px; overflow: hidden;\">\n89:       <div class=\"p-4\" style=\"backgro