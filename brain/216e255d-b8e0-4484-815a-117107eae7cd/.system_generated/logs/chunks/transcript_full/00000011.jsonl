{"step_index":467,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T20:13:14Z","content":"Created At: 2026-09-11T02:13:14+06:00\nCompleted At: 2026-09-11T02:13:14+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/server/routes/history.js`\nTotal Lines: 76\nTotal Bytes: 2102\nShowing lines 1 to 76\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const express = require('express');\n2: const router = express.Router();\n3: const MedicineHistory = require('../models/MedicineHistory');\n4: const { protect } = require('../middleware/auth');\n5: const { authorizeRoles } = require('../middleware/roles');\n6: \n7: // @route   GET /api/history\n8: // @desc    Get current customer's verification and purchase history\n9: // @access  Private/Customer\n10: router.get('/', protect, authorizeRoles('customer', 'admin'), async (req, res) => {\n11:   try {\n12:     const { type } = req.query;\n13:     const query = { customerId: req.user._id };\n14: \n15:     if (type && type !== 'ALL') {\n16:       query.type = type;\n17:     }\n18: \n19:     const history = await MedicineHistory.find(query)\n20:       .populate('medicineId')\n21:       .populate('pharmacyId', 'name address phone area')\n22:       .sort({ checkedAt: -1 });\n23: \n24:     res.json({\n25:       success: true,\n26:       count: history.length,\n27:       data: history,\n28:     });\n29:   } catch (err) {\n30:     res.status(500).json({ success: false, message: err.message });\n31:   }\n32: });\n33: \n34: // @route   DELETE /api/history/:id\n35: // @desc    Delete a specific history item\n36: // @access  Private/Customer\n37: router.delete('/:id', protect, authorizeRoles('customer', 'admin'), async (req, res) => {\n38:   try {\n39:     const item = await MedicineHistory.findOne({\n40:       _id: req.params.id,\n41:       customerId: req.user._id,\n42:     });\n43: \n44:     if (!item) {\n45:       return res.status(404).json({ success: false, message: 'History record not found' });\n46:     }\n47: \n48:     await item.deleteOne();\n49: \n50:     res.json({\n51:       success: true,\n52:       message: 'Record removed from history',\n53:     });\n54:   } catch (err) {\n55:     res.status(500).json({ success: false, message: err.message });\n56:   }\n57: });\n58: \n59: // @route   DELETE /api/history\n60: // @desc    Clear all history for customer\n61: // @access  Private/Customer\n62: router.delete('/', protect, authorizeRoles('customer'), async (req, res) => {\n63:   try {\n64:     await MedicineHistory.deleteMany({ customerId: req.user._id });\n65: \n66:     res.json({\n67:       success: true,\n68:       message: 'Medicine history cleared successfully',\n69:     });\n70:   } catch (err) {\n71:     res.status(500).json({ success: false, message: err.message });\n72:   }\n73: });\n74: \n75: module.exports = router;\n76: \nThe above content shows the entire, complete file contents of the requested file.\n"}
