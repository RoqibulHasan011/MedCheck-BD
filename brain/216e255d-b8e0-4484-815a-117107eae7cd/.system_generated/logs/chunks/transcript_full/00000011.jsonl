{"step_index":475,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T20:13:35Z","content":"Created At: 2026-09-11T02:13:35+06:00\nCompleted At: 2026-09-11T02:13:35+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/client/js/auth.js`\nTotal Lines: 230\nTotal Bytes: 7560\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * MedCheck BD - Authentication Client Script\n3:  * Handles Registration, Login, Token Management, and Role Guards.\n4:  */\n5: \n6: const API_BASE = '/api';\n7: \n8: // Helper to get auth headers\n9: function getAuthHeaders() {\n10:   const token = localStorage.getItem('token');\n11:   return {\n12:     'Content-Type': 'application/json',\n13:     Authorization: token ? `Bearer ${token}` : '',\n14:   };\n15: }\n16: \n17: // Check role guard on private dashboard pages\n18: function enforceRoleGuard(allowedRoles = []) {\n19:   const token = localStorage.getItem('token');\n20:   const user = JSON.parse(localStorage.getItem('user') || 'null');\n21: \n22:   if (!token || !user) {\n23:     showToast('Please login to access your dashboard', 'warning');\n24:     setTimeout(() => {\n25:       window.location.href = 'login.html';\n26:     }, 1000);\n27:     return false;\n28:   }\n29: \n30:   if (allowedRoles.length > 0 && !allowedRoles.includes(user.role)) {\n31:     showToast(`Unauthorized access. Required: ${allowedRoles.join(', ')}`, 'danger');\n32:     setTimeout(() => {\n33:       if (user.role === 'admin') window.location.href = 'admin-dashboard.html';\n34:       else if (user.role === 'pharmacy') window.location.href = 'pharmacy-dashboard.html';\n35:       else window.location.href = 'customer-dashboard.html';\n36:     }, 1200);\n37:     return false;\n38:   }\n39: \n40:   return true;\n41: }\n42: \n43: // Quick-fill demo login credentials\n44: function quickFillLogin(role) {\n45:   const emailInput = document.getElementById('loginEmail');\n46:   const passwordInput = document.getElementById('loginPassword');\n47:   if (!emailInput || !passwordInput) return;\n48: \n49:   if (role === 'admin') {\n50:     emailInput.value = 'admin@medcheckbd.com';\n51:     passwordInput.value = 'Admin@1234';\n52:   } else if (role === 'pharmacy') {\n53:     emailInput.value = 'pharmacy@medcare.com';\n54:     passwordInput.value = 'Pharmacy@123';\n55:   } else if (role === 'customer') {\n56:     emailInput.value = 'customer@gmail.com';\n57:     passwordInput.value = 'Customer@123';\n58:   }\n59:   showToast(`Auto-filled ${role.toUpperCase()} credentials`, 'info');\n60: }\n61: \n62: // Handle Login\n63: async function handleLogin(e) {\n64:   e.preventDefault();\n65:   const email = document.getElementById('loginEmail').value.trim();\n66:   const password = document.getElementById('loginPassword').value;\n67:   const submitBtn = document.getElementById('loginBtn');\n68: \n69:   if (!email || !password) {\n70:     showToast('Please provide both email and password', 'warning');\n71:     return;\n72:   }\n73: \n74:   submitBtn.disabled = true;\n75:   submitBtn.innerHTML = '<span class=\"spinner-border spinner-border-sm me-2\"></span>Authenticating...';\n76: \n77:   try {\n78:     const res = await fetch(`${API_BASE}/auth/login`, {\n79:       method: 'POST',\n80:       headers: { 'Content-Type': 'application/json' },\n81:       body: JSON.stringify({ email, password }),\n82:     });\n83: \n84:     const data = await res.json();\n85: \n86:     if (!res.ok) {\n87:       throw new Error(data.message || 'Login failed');\n88:     }\n89: \n90:     // Save tokens and user session\n91:     localStorage.setItem('token', data.token);\n92:     localStorage.setItem('user', JSON.stringify(data.user));\n93:     if (data.pharmacy) {\n94:       localStorage.setItem('pharmacy'