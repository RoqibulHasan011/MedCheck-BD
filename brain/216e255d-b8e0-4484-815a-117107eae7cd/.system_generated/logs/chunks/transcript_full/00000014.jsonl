{"step_index":569,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T20:25:01Z","content":"Created At: 2026-09-11T02:25:01+06:00\nCompleted At: 2026-09-11T02:25:01+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/client/js/verify.js`\nTotal Lines: 378\nTotal Bytes: 15434\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * MedCheck BD - Verification Client Script\n3:  * Handles live medicine & batch verification lookups, barcode simulation, and UI rendering.\n4:  */\n5: \n6: document.addEventListener('DOMContentLoaded', () => {\n7:   const urlParams = new URLSearchParams(window.location.search);\n8:   const initialQuery = urlParams.get('query');\n9:   if (initialQuery) {\n10:     const input = document.getElementById('verifyInput');\n11:     if (input) input.value = decodeURIComponent(initialQuery);\n12:     executeVerification(initialQuery);\n13:   }\n14: \n15:   // Initialize live autocomplete dropdown\n16:   setupMedicineAutocomplete('verifyInput', (selectedName) => {\n17:     executeVerification(selectedName);\n18:   });\n19: });\n20: \n21: // Barcode simulation: sets demo barcode into search field\n22: function simulateBarcodeScan(barcode = '894110000101') {\n23:   const input = document.getElementById('verifyInput');\n24:   if (!input) return;\n25:   input.value = barcode;\n26:   showToast(`Scanned Barcode: ${barcode}`, 'info');\n27:   executeVerification(barcode);\n28: }\n29: \n30: // Main verification handler\n31: async function handleVerifySubmit(e) {\n32:   if (e) e.preventDefault();\n33:   const input = document.getElementById('verifyInput');\n34:   const query = input ? input.value.trim() : '';\n35: \n36:   if (!query) {\n37:     showToast('Please enter a medicine name, generic, batch or barcode', 'warning');\n38:     return;\n39:   }\n40: \n41:   await executeVerification(query);\n42: }\n43: \n44: async function executeVerification(query) {\n45:   const resultContainer = document.getElementById('verifyResultArea');\n46:   const searchBtn = document.getElementById('verifySearchBtn');\n47: \n48:   if (!resultContainer) return;\n49: \n50:   if (searchBtn) {\n51:     searchBtn.disabled = true;\n52:     searchBtn.innerHTML = '<span class=\"spinner-border spinner-border-sm me-2\"></span>Checking records...';\n53:   }\n54: \n55:   resultContainer.innerHTML = `\n56:     <div class=\"text-center py-5\">\n57:       <div class=\"spinner-border text-primary\" style=\"width: 3rem; height: 3rem;\" role=\"status\"></div>\n58:       <p class=\"mt-3 text-muted fw-bold\">Cross-referencing MedCheck BD Reference Database...</p>\n59:     </div>\n60:   `;\n61: \n62:   try {\n63:     const token = localStorage.getItem('token');\n64:     const headers = { 'Content-Type': 'application/json' };\n65:     if (token) headers.Authorization = `Bearer ${token}`;\n66: \n67:     const res = await fetch(`/api/verify/${encodeURIComponent(query)}`, { headers });\n68:     const data = await res.json();\n69: \n70:     if (!data.success || !data.matchFound) {\n71:       renderNotFoundResult(query, data);\n72:       return;\n73:     }\n74: \n75:     renderMatchResult(data);\n76:   } catch (err) {\n77:     resultContainer.innerHTML = `\n78:       <div class=\"alert alert-danger shadow-sm border-0\" role=\"alert\">\n79:         <i class=\"fas fa-exclamation-triangle me-2\"></i> Verification query failed: ${err.message}\n80:       </div>\n81:     `;\n82:   } finally {\n83:     if (searchBtn) {\n84:       searchBtn.disabled = false;\n85:       searchBtn.innerHTML = '<i class=\"fas fa-search me-2\"></i>Verify Medicine';\n86:     }\n87:   }\n88: }\n89: \n90: function renderNotFoundResult(query, data) {\n91:   const resultContainer = document.getElementById('verifyResultArea');\n92: \n93:   let suggestionsHtml = '';\n94:   if (data.suggestions && data.suggestions.length > 0) {\n95:     suggestionsHtml = `\n96:       <div class=\"mt-4 pt-3 border-top\">\n97:         <h6 class=\"fw-bold text-navy mb-2\"><i class=\"fas fa-lightbulb text-warning me-2\"></i>Did you mean one of these registered medicines?</h6>\n98:         <div class=\"d-flex flex-wrap gap-2\">\n99:           ${data.suggestions\n100:             .map(\n101:               (s) => `\n102:             <button type=\"button\" class=\"btn btn-outline-primary btn-sm\" onclick=\"document.getElementById('verifyInput').value='${s.name}'; executeVerification('${s.name}');\">\n103:               <i class=\"fas fa-pills me-1\"></i> ${s.name} <span class=\"text-muted small\">(${s.genericName})</span>\n104:             </button>\n105:           `\n106:             )\n107:             .join('')}\n108:         </div>\n109:       </div>\n110:     `;\n111:   }\n112: \n113:   resultContainer.innerHTML = `\n114:     <div class=\"card border-0 shadow-lg\" style=\"border-radius: 16px; overflow: hidden;\">\n115:       <div class=\"p-4\" style=\"background: linear-gradient(135deg, #dc2626, #ef4444); color: white;\">\n116:         <div class=\"d-flex align-items-center justify-content-between\">\n117:           <div class=\"d-flex align-items-center gap-3\">\n118:             <i class=\"fas fa-times-circle fa-2x\"></i>\n119:             <div>\n120:               <h4 class=\"mb-0 fw-bold\">No Exact Database Match Found</h4>\n121:               <small class=\"opacity-75\">Verification Target: \"${query}\"</small>\n122:             </div>\n123:           </div>\n124:           <span class=\"status-pill notfound text-white bg-dark bg-opacity-25 border-0\">\n125:             <i class=\"fas fa-ban me-1\"></i> RECORD NOT FOUND\n126:           </span>\n127:         </div>\n128:       </div>\n129:       <div class=\"card-body p-4 bg-white\">\n130:         <p class=\"text-secondary mb-3\">${data.message || 'No approved reference or registered batch found matching this term.'}</p>\n131:         <div class=\"alert alert-warning border-0 small\">\n132:           <i class=\"fas fa-shield-alt text-warning me-2\"></i>\n133:           <strong>Precautionary Notice:</strong> Absence from this database does not solely confirm a counterfeit medicine, but warrants careful consultation with a licensed pharmacist or physician before consumption.\n134:         </div>\n135: \n136:         ${suggestionsHtml}\n137: \n138:         <div class=\"d-flex flex-wrap gap-2 mt-4 pt-2 border-top\">\n139:           <a href=\"report.html?medicine=${encodeURIComponent(query)}\" class=\"btn btn-outline-danger btn-sm\">\n140:             <i class=\"fas fa-flag me-1\"></i> Report Unregistered / Suspicious Medicine\n141:           </a>\n142:           <a href=\"price.html?medicine=${encodeURIComponent(query)}\" class=\"btn btn-outline-success btn-sm\">\n143:             <i class=\"fas fa-tags me-1\"></i> Check Market Prices\n144:           </a>\n145:           <a href=\"verify.html\" class=\"btn btn-light btn-sm ms-auto\">Clear Search</a>\n146:         </div>\n147:       </div>\n148:     </div>\n149:   `;\n150: }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
