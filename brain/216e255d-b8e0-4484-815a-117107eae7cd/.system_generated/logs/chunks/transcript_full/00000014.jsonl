-lg border-0 mb-2\" role=\"alert\" aria-live=\"assertive\" aria-atomic=\"true\" style=\"border-radius: 12px; background: #ffffff;\">\n39:       <div class=\"d-flex p-3 align-items-center\">\n40:         <i class=\"fas ${icons[type] || icons.info} fa-lg me-3\"></i>\n41:         <div class=\"toast-body p-0 flex-grow-1\" style=\"font-size: 0.92rem; font-weight: 500; color: #1e293b;\">\n42:           ${message}\n43:         </div>\n44:         <button type=\"button\" class=\"btn-close ms-2\" onclick=\"document.getElementById('${toastId}').remove()\"></button>\n45:       </div>\n46:     </div>\n47:   `;\n48: \n49:   toastContainer.insertAdjacentHTML('beforeend', toastHtml);\n50: \n51:   setTimeout(() => {\n52:     const el = document.getElementById(toastId);\n53:     if (el) el.remove();\n54:   }, 4500);\n55: }\n56: \n57: // Render dynamic navbar based on user role and auth status\n58: function renderNavbar() {\n59:   const navContainer = document.getElementById('mainNavbar');\n60:   if (!navContainer) return;\n61: \n62:   const token = localStorage.getItem('token');\n63:   const user = JSON.parse(localStorage.getItem('user') || 'null');\n64:   const currentPath = window.location.pathname;\n65: \n66:   let authLinks = `\n67:     <li class=\"nav-item\">\n68:       <a class=\"nav-link nav-link-custom ${currentPath.includes('login') ? 'active' : ''}\" href=\"login.html\">\n69:         <i class=\"fas fa-sign-in-alt me-1\"></i> Login\n70:       </a>\n71:     </li>\n72:     <li class=\"nav-item ms-lg-2\">\n73:       <a class=\"btn btn-primary-custom btn-sm px-3\" href=\"register.html\">\n74:         <i class=\"fas fa-user-plus me-1\"></i> Register\n75:       </a>\n76:     </li>\n77:   `;\n78: \n79:   if (token && user) {\n80:     let dashboardLink = 'customer-dashboard.html';\n81:     let roleBadge = '<span class=\"badge bg-primary ms-1\">Customer</span>';\n82: \n83:     if (user.role === 'admin') {\n84:       dashboardLink = 'admin-dashboard.html';\n85:       roleBadge = '<span class=\"badge bg-danger ms-1\">Admin</span>';\n86:     } else if (user.role === 'pharmacy') {\n87:       dashboardLink = 'pharmacy-dashboard.html';\n88:       roleBadge = '<span class=\"badge bg-success ms-1\">Pharmacy</span>';\n89:     }\n90: \n91:     authLinks = `\n92:       <li class=\"nav-item\">\n93:         <a class=\"nav-link nav-link-custom fw-bold text-primary ${currentPath.includes('dashboard') ? 'active' : ''}\" href=\"${dashboardLink}\">\n94:           <i class=\"fas fa-columns me-1\"></i> Dashboard\n95:         </a>\n96:       </li>\n97:       ${user.role === 'customer' ? `\n98:       <li class=\"nav-item\">\n99:         <a class=\"nav-link nav-link-custom ${currentPath.includes('history') ? 'active' : ''}\" href=\"history.html\">\n100:           <i class=\"fas fa-history me-1\"></i> My History\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
