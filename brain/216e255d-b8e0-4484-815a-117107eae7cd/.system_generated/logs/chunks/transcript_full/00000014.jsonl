 text-muted\"><i class=\"fas fa-map-marker-alt text-danger me-1\"></i>${item.pharmacy.area}</div>\n164:                 </td>\n165:                 <td>\n166:                   <span class=\"fs-5 fw-bold text-navy\">${formatBDT(item.price)}</span>\n167:                   ${isLowest ? '<span class=\"badge bg-success ms-2\"><i class=\"fas fa-star me-1\"></i>Lowest Price</span>' : ''}\n168:                 </td>\n169:                 <td>${diffBadge}</td>\n170:                 <td>\n171:                   <span class=\"badge ${item.status === 'Available' ? 'bg-success' : (item.status === 'Low Stock' ? 'bg-warning text-dark' : 'bg-danger')}\">\n172:                     ${item.status}\n173:                   </span>\n174:                 </td>\n175:                 <td class=\"small text-muted\">${formatDate(item.updatedAt)}</td>\n176:                 <td class=\"text-end\">\n177:                   <a href=\"pharmacy-details.html?id=${item.pharmacy.id}\" class=\"btn btn-outline-primary btn-sm py-1\">\n178:                     View Stock\n179:                   </a>\n180:                 </td>\n181:               </tr>\n182:             `;\n183:           }).join('');\n184:         }\n185: \n186:         container.innerHTML = `\n187:           <div class=\"card-custom p-4 mb-4\">\n188:             <!-- Medicine Info Banner -->\n189:             <div class=\"row align-items-center mb-4 border-bottom pb-3 g-3\">\n190:               <div class=\"col-md-7\">\n191:                 <span class=\"badge bg-primary-subtle text-primary fw-bold text-uppercase mb-1\">${medicine.dosageForm}</span>\n192:                 <h3 class=\"fw-bold text-navy mb-1\">${medicine.name}</h3>\n193:                 <div class=\"text-secondary\">${medicine.genericName} • ${medicine.strength}</div>\n194:                 <div class=\"small text-muted\">Manufacturer: <strong>${medicine.manufacturer}</strong></div>\n195:               </div>\n196:               <div class=\"col-md-5 text-md-end\">\n197:                 <div class=\"p-3 bg-light rounded-3 d-inline-block text-start text-md-end\">\n198:                   <div class=\"small text-muted\">DGDA Official Reference Benchmark</div>\n199:                   <div class=\"fs-3 fw-bold text-primary\">${formatBDT(medicine.referencePrice)}</div>\n200:                   <div class=\"small text-success fw-bold\">\n201:                     ${lowestPrice ? `Lowest available in store: ${formatBDT(lowestPrice)}` : ''}\n202:                   </div>\n203:                 </div>\n204:               </div>\n205:             </div>\n206: \n207:             <!-- Price Table -->\n208:             <h5 class=\"fw-bold text-navy mb-3\"><i class=\"fas fa-store text-primary me-2\"></i>Pharmacy Price Comparison</h5>\n209:             <div class=\"table-responsive\">\n210:               <table class=\"table table-custom align-middle mb-0\">\n211:                 <thead>\n212:                   <tr>\n213:                     <th>Pharmacy & Location</th>\n214:                     <th>Selling Price</th>\n215:                     <th>Variance vs Ref</th>\n216:                     <th>Availability</th>\n217:                     <th>Updated</th>\n218:                     <th class=\"text-end\">Action</th>\n219:                   </tr>\n220:                 </thead>\n221:                 <tbody>\n222:                   ${rowsHtml}\n223:                 </tbody>\n224:               </table>\n225:             </div>\n226:           </div>\n227:         `;\n228:       } catch (err) {\n229:         container.innerHTML = `<div class=\"alert alert-danger\">${err.message}</div>`;\n230:       } finally {\n231:         if (searchBtn) {\n232:           searchBtn.disabled = false;\n233:           searchBtn.innerHTML = '<i class=\"fas fa-search me-2\"></i>Check Prices';\n234:         }\n235:       }\n236:     }\n237:   </script>\n238: </body>\n239: </html>\n240: \nThe above content does NOT show the entire file contents. If you need to view any lines of 