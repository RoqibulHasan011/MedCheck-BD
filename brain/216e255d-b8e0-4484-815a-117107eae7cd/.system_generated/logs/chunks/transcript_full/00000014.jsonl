:     });\n730: \n731:     // Close modal\n732:     const modalEl = document.getElementById('customerOrderModal');\n733:     const bsModal = bootstrap.Modal.getInstance(modalEl);\n734:     if (bsModal) bsModal.hide();\n735: \n736:     // Show success dialog\n737:     showToast(`Order Confirmed! Receipt: ${data.receiptId}`, 'success');\n738: \n739:     setTimeout(() => {\n740:       if (confirm(`Order placed successfully!\\nReceipt: ${data.receiptId}\\n\\nWould you like to view your printable digital receipt now?`)) {\n741:         window.location.href = `receipt.html?id=${data.receiptId}`;\n742:       } else if (window.location.pathname.includes('history.html')) {\n743:         if (typeof loadCustomerHistory === 'function') loadCustomerHistory();\n744:       }\n745:     }, 400);\n746:   } catch (err) {\n747:     showToast(err.message, 'danger');\n748:   } finally {\n749:     if (btn) {\n750:       btn.disabled = false;\n751:       btn.innerHTML = '<i class=\"fas fa-check-circle me-1\"></i> Confirm & Place Order';\n752:     }\n753:   }\n754: };\n755: \n756: // Auto-run on DOM Content Loaded\n757: document.addEventListener('DOMContentLoaded', () => {\n758:   renderNavbar();\n759:   renderFooter();\n760: });\n761: \n762: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
