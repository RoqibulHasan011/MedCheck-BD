return true;\n41: }\n42: \n43: // Quick-fill demo login credentials\n44: function quickFillLogin(role) {\n45:   const emailInput = document.getElementById('loginEmail');\n46:   const passwordInput = document.getElementById('loginPassword');\n47:   if (!emailInput || !passwordInput) return;\n48: \n49:   if (role === 'admin') {\n50:     emailInput.value = 'admin@medcheckbd.com';\n51:     passwordInput.value = 'Admin@1234';\n52:   } else if (role === 'pharmacy') {\n53:     emailInput.value = 'pharmacy@medcare.com';\n54:     passwordInput.value = 'Pharmacy@123';\n55:   } else if (role === 'customer') {\n56:     emailInput.value = 'customer@gmail.com';\n57:     passwordInput.value = 'Customer@123';\n58:   }\n59:   showToast(`Auto-filled ${role.toUpperCase()} credentials`, 'info');\n60: }\n61: \n62: // Handle Login\n63: async function handleLogin(e) {\n64:   e.preventDefault();\n65:   const email = document.getElementById('loginEmail').value.trim();\n66:   const password = document.getElementById('loginPassword').value;\n67:   const submitBtn = document.getElementById('loginBtn');\n68: \n69:   if (!email || !password) {\n70:     showToast('Please provide both email and password', 'warning');\n71:     return;\n72:   }\n73: \n74:   submitBtn.disabled = true;\n75:   submitBtn.innerHTML = '<span class=\"spinner-border spinner-border-sm me-2\"></span>Authenticating...';\n76: \n77:   try {\n78:     const res = await fetch(`${API_BASE}/auth/login`, {\n79:       method: 'POST',\n80:       headers: { 'Content-Type': 'application/json' },\n81:       body: JSON.stringify({ email, password }),\n82:     });\n83: \n84:     const data = await res.json();\n85: \n86:     if (!res.ok) {\n87:       throw new Error(data.message || 'Login failed');\n88:     }\n89: \n90:     // Save tokens and user session\n91:     localStorage.setItem('token', data.token);\n92:     localStorage.setItem('user', JSON.stringify(data.user));\n93:     if (data.pharmacy) {\n94:       localStorage.setItem('pharmacy', JSON.stringify(data.pharmacy));\n95:     } else {\n96:       localStorage.removeItem('pharmacy');\n97:     }\n98: \n99:     showToast(`Welcome back, ${data.user.name}!`, 'success');\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
