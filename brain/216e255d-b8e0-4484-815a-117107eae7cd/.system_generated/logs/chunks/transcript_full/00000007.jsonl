{"step_index":276,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T19:45:55Z","content":"Created At: 2026-09-11T01:45:55+06:00\nCompleted At: 2026-09-11T01:45:55+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/client/js/pharmacy.js`\nTotal Lines: 225\nTotal Bytes: 9416\nShowing lines 1 to 225\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: /**\n2:  * MedCheck BD - Pharmacy Directory & Stock Client Script\n3:  * Handles pharmacy directory lookup, location filtering, and pharmacy profile stock rendering.\n4:  */\n5: \n6: // Load pharmacies on pharmacies.html\n7: async function loadPharmacies() {\n8:   const container = document.getElementById('pharmacyList');\n9:   if (!container) return;\n10: \n11:   const areaSelect = document.getElementById('filterArea');\n12:   const searchInput = document.getElementById('searchPharmacy');\n13:   const medicineInput = document.getElementById('filterMedicine');\n14: \n15:   const area = areaSelect ? areaSelect.value : 'All Areas';\n16:   const search = searchInput ? searchInput.value.trim() : '';\n17:   const medicineName = medicineInput ? medicineInput.value.trim() : '';\n18: \n19:   container.innerHTML = `\n20:     <div class=\"col-12 text-center py-5\">\n21:       <div class=\"spinner-border text-primary\" role=\"status\"></div>\n22:       <p class=\"text-muted mt-2\">Loading verified pharmacies...</p>\n23:     </div>\n24:   `;\n25: \n26:   try {\n27:     const params = new URLSearchParams();\n28:     if (area && area !== 'All Areas') params.append('area', area);\n29:     if (search) params.append('search', search);\n30:     if (medicineName) params.append('medicineName', medicineName);\n31: \n32:     const res = await fetch(`/api/pharmacies?${params.toString()}`);\n33:     const data = await res.json();\n34: \n35:     if (!data.success || data.count === 0) {\n36:       container.innerHTML = `\n37:         <div class=\"col-12 text-center py-5\">\n38:           <div class=\"p-4 bg-white rounded-3 shadow-sm border text-center\">\n39:             <i class=\"fas fa-store-slash fa-3x text-muted mb-3\"></i>\n40:             <h5>No Pharmacies Found</h5>\n41:             <p class=\"text-muted\">No verified pharmacies matched your selected location or medicine search.</p>\n42:             <button class=\"btn btn-outline-primary btn-sm\" onclick=\"resetPharmacyFilters()\">Reset Filters</button>\n43:           </div>\n44:         </div>\n45:       `;\n46:       return;\n47:     }\n48: \n49:     container.innerHTML = data.data\n50:       .map((p) => {\n51:         const sampleMeds =\n52:           p.availableSampleMedicines && p.availableSampleMedicines.length > 0\n53:             ? p.availableSampleMedicines\n54:                 .map((m) => `<span class=\"badge bg-light text-dark border me-1 mb-1\">${m}</span>`)\n55:                 .join('')\n56:             : '<span class=\"text-muted small\">Standard stock available</span>';\n57: \n58:         return `\n59:         <div class=\"col-lg-6 mb-4\">\n60:           <div class=\"card-custom h-100 p-4\">\n61:             <div class=\"d-flex justify-content-between align-items-start mb-3\">\n62:               <div>\n63:                 <h5 class=\"fw-bold mb-1 text-dark\">${p.name}</h5>\n64:                 <span class=\"status-pill ${p.verified ? 'verified' : 'review'}\">\n65:                   ${p.verified ? '<i class=\"fas fa-check-circle me-1\"></i> VERIFIED PHARMACY' : '<i class=\"fas fa-clock me-1\"></i> PENDING VERIFICATION'}\n66:                 </span>\n67:               </div>\n68:               <span class=\"badge ${p.isOpenNow ? 'bg-success' : 'bg-secondary'} px-2 py-1\">\n69:                 ${p.isOpenNow ? 'Open Now' : 'Closed'}\n70:               </span>\n71:             </div>\n72: \n73:             <p class=\"text-secondary small mb-2\">\n74:               <i class=\"fas fa-map-marker-alt text-danger me-2\"></i><strong>${p.area}, ${p.division || 'Dhaka'}:</strong> ${p.address}\n75:             </p>\n76:             <p class=\"text-secondary small mb-2\">\n77:               <i class=\"fas fa-phone-alt text-primary me-2\"></i>${p.phone}\n78:             </p>\n79:             <p class=\"text-secondary small mb-3\">\n80:               <i class=\"fas fa-clock text-warning me-2\"></i>Hours: ${p.openingHours || '8:00 AM - 11:00 PM'}\n81:             </p>\n82: \n83:             <div class=\"mb-3 pt-2 border-top\">\n84:               <span class=\"small text-muted fw-bold d-block mb-1\">Available In-Stock:</span>\n85:               <div>${sampleMeds}</div>\n86:             </div>\n87: \n88:             <div class=\"d-flex gap-2 mt-auto pt-2 border-top\">\n89:               <a href=\"pharmacy-details.html?id=${p._id}\" class=\"btn btn-primary-custom btn-sm flex-grow-1\">\n90:                 <i class=\"fas fa-boxes me-1\"></i> View Stock & Prices\n91:               </a>\n92:               <a href=\"tel:${p.phone}\" class=\"btn btn-outline-secondary btn-sm\">\n93:                 <i class=\"fas fa-phone\"></i>\n94:               </a>\n95:             </div>\n96:           </div>\n97:         </div>\n98:       `;\n99:       })\n100:       .join('');\n101:   } catch (err) {\n102:     container.innerHTML = `\n103:       <div class=\"col-12 alert alert-danger\" role=\"alert\">\n104:         <i class=\"fas fa-exclamation-triangle me-2\"></i> Failed to load pharmacies: ${err.message}\n105:       </div>\n106:     `;\n107:   }\n108: }\n109: \n110: function resetPharmacyFilters() {\n111:   const areaSelect = document.getElementById('filterArea');\n112:   const searchInput = document.getElementById('searchPharmacy');\n113:   const medicineInput = document.getElementById('filterMedicine');\n114:   if (areaSelect) areaSelect.value = 'All Areas';\n115:   if (searchInput)