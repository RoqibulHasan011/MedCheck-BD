s=\"row g-3 align-items-end\">\n32:           <div class=\"col-md-4\">\n33:             <label class=\"form-label fw-bold text-navy small\">Select Area / Hub</label>\n34:             <select id=\"filterArea\" class=\"form-select\" onchange=\"loadPharmacies()\">\n35:               <option value=\"All Areas\">All Areas (Bangladesh)</option>\n36:               <option value=\"Dhanmondi\">Dhanmondi, Dhaka</option>\n37:               <option value=\"Mirpur\">Mirpur, Dhaka</option>\n38:               <option value=\"Uttara\">Uttara, Dhaka</option>\n39:               <option value=\"Mohammadpur\">Mohammadpur, Dhaka</option>\n40:               <option value=\"Gulshan\">Gulshan, Dhaka</option>\n41:               <option value=\"Banani\">Banani, Dhaka</option>\n42:               <option value=\"Chittagong\">Chittagong Division</option>\n43:               <option value=\"Sylhet\">Sylhet Division</option>\n44:               <option value=\"Rajshahi\">Rajshahi Division</option>\n45:             </select>\n46:           </div>\n47: \n48:           <div class=\"col-md-4\">\n49:             <label class=\"form-label fw-bold text-navy small\">Filter by Available Medicine</label>\n50:             <div class=\"input-group\">\n51:               <span class=\"input-group-text bg-white\"><i class=\"fas fa-pills text-muted\"></i></span>\n52:               <input\n53:                 type=\"text\"\n54:                 id=\"filterMedicine\"\n55:                 class=\"form-control\"\n56:                 placeholder=\"e.g. Napa, Seclo, Ace...\"\n57:                 onkeyup=\"if(event.key==='Enter') loadPharmacies()\"\n58:               >\n59:             </div>\n60:           </div>\n61: \n62:           <div class=\"col-md-4\">\n63:             <label class=\"form-label fw-bold text-navy small\">Search Pharmacy Name</label>\n64:             <div class=\"input-group\">\n65:               <input\n66:                 type=\"text\"\n67:                 id=\"searchPharmacy\"\n68:                 class=\"form-control\"\n69:                 placeholder=\"e.g. MedCare, Lazz Pharma...\"\n70:                 onkeyup=\"if(event.key==='Enter') loadPharmacies()\"\n71:               >\n72:               <button class=\"btn btn-primary-custom\" type=\"button\" onclick=\"loadPharmacies()\">\n73:                 <i class=\"fas fa-search\"></i>\n74:               </button>\n75:             </div>\n76:           </div>\n77:         </div>\n78:       </div>\n79: \n80:       <!-- Pharmacy Cards Grid -->\n81:       <div class=\"row\" id=\"pharmacyList\">\n82:         <!-- Loaded dynamically via js/pharmacy.js -->\n83:       </div>\n84:     </div>\n85:   </main>\n86: \n87:   <!-- Dynamic Footer -->\n88:   <div id=\"mainFooter\"></div>\n89: \n90:   <!-- Scripts -->\n91:   <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n92:   <script src=\"js/main.js\"></script>\n93:   <script src=\"js/auth.js\"></script>\n94:   <script src=\"js/pharmacy.js\"></script>\n95:   <script>\n96:     document.addEventListener('DOMContentLoaded', () => {\n97:       const urlParams = new URLSearchParams(window.location.search);\n98:       const med = urlParams.get('medicine');\n99:       if (med) {\n100:         const medInput = document.getElementById('filterMedicine');\n101:         if (medInput) medInput.value = decodeURIComponent(med);\n102:       }\n103:       loadPharmacies();\n104:     });\n105:   </script>\n106: </body>\n107: </html>\n108: \nThe above content shows the entire, complete file contents of the requested file.\n"}
