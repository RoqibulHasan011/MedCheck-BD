{"step_index":272,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T19:45:50Z","content":"Created At: 2026-09-11T01:45:50+06:00\nCompleted At: 2026-09-11T01:45:51+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/server/routes/pharmacies.js`\nTotal Lines: 216\nTotal Bytes: 6705\nShowing lines 1 to 216\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const express = require('express');\n2: const router = express.Router();\n3: const Pharmacy = require('../models/Pharmacy');\n4: const Inventory = require('../models/Inventory');\n5: const Medicine = require('../models/Medicine');\n6: const { protect, optionalAuth } = require('../middleware/auth');\n7: const { authorizeRoles } = require('../middleware/roles');\n8: const { logAccess } = require('../middleware/logger');\n9: \n10: // @route   GET /api/pharmacies\n11: // @desc    Get verified and approved pharmacies with location and medicine search\n12: // @access  Public\n13: router.get('/', optionalAuth, async (req, res) => {\n14:   try {\n15:     const { area, division, search, medicineName, verifiedOnly } = req.query;\n16: \n17:     const query = { status: 'Approved' };\n18: \n19:     if (area && area !== 'All Areas') {\n20:       query.area = area;\n21:     }\n22:     if (division && division !== 'All Divisions') {\n23:       query.division = division;\n24:     }\n25:     if (verifiedOnly === 'true') {\n26:       query.verified = true;\n27:     }\n28:     if (search) {\n29:       query.$or = [\n30:         { name: { $regex: search.trim(), $options: 'i' } },\n31:         { address: { $regex: search.trim(), $options: 'i' } },\n32:         { area: { $regex: search.trim(), $options: 'i' } },\n33:       ];\n34:     }\n35: \n36:     // If searching by medicine availability\n37:     let pharmacyIdsWithMedicine = null;\n38:     if (medicineName && medicineName.trim()) {\n39:       const matchingMeds = await Medicine.find({\n40:         $or: [\n41:           { name: { $regex: medicineName.trim(), $options: 'i' } },\n42:           { genericName: { $regex: medicineName.trim(), $options: 'i' } },\n43:         ],\n44:       }).select('_id');\n45: \n46:       const medIds = matchingMeds.map((m) => m._id);\n47:       const matchingInv = await Inventory.find({\n48:         medicineId: { $in: medIds },\n49:         quantity: { $gt: 0 },\n50:       }).distinct('pharmacyId');\n51: \n52:       pharmacyIdsWithMedicine = matchingInv;\n53:       query._id = { $in: pharmacyIdsWithMedicine };\n54:     }\n55: \n56:     const pharmacies = await Pharmacy.find(query).sort({ verified: -1, name: 1 });\n57: \n58:     // Attach sample available medicines snippet to each pharmacy\n59:     const enriched = await Promise.all(\n60:       pharmacies.map(async (pharmacy) => {\n61:         const pObj = pharmacy.toObject();\n62:         const topInventory = await Inventory.find({ pharmacyId: pharmacy._id, quantity: { $gt: 0 } })\n63:           .populate('medicineId', 'name genericName')\n64:           .limit(5);\n65: \n66:         pObj.availableSampleMedicines = topInventory\n67:           .filter((inv) => inv.medicineId)\n68:           .map((inv) => inv.medicineId.name);\n69: \n70:         return pObj;\n71:       })\n72:     );\n73: \n74:     res.json({\n75:       success: true,\n76:       count: enriched.length,\n77:       data: enriched,\n78:     });\n79:   } catch (err) {\n80:     res.status(500).json({ success: false, message: err.message });\n81:   }\n82: });\n83: \n84: // @route   GET /api/pharmacies/:id\n85: // @desc    Get single pharmacy details and its active stock\n86: // @access  Public\n87: router.get('/:id', optionalAuth, async (req, res) => {\n88:   try {\n89:     const pharmacy = await Pharmacy.findById(req.params.id);\n90:     if (!pharmacy) {\n91:       return res.status(404).json({ success: false, message: 'Pharmacy not found' });\n92:     }\n93: \n94:     // Fetch live inventory for this pharmacy\n95:     const inventory = await Inventory.find({ pharmacyId: pharmacy._id })\n96:       .populate('medicineId')\n97:       .populate('batchId')\n98:       .sort({ updatedAt: -1 });\n99: \n100:     // Format stock details with calculated statuses\n101:     const now = new Date();\n102:     const stockItems = inventory.map((item) => {\n103:       const med = item.medicineId;\n104:       const batch = item.batchId;\n105: \n106:       let batchStatus = 'VALID';\n107:       let daysToExpiry = 999;\n108:       if (batch) {\n109:         daysToExpiry = Math.ceil((new Date(batch.expiryDate) - now) / (1000 * 60 * 60 * 24));\n110:         if (daysToExpiry <= 0) batchStatus = 'EXPIRED';\n111:         else if (daysToExpiry <= 60) batchStatus = 'EXPIRING SOON';\n112:       }\n113: \n114:       let stockStatus = 'IN STOCK';\n115:       if (item.quantity <= 0) stockStatus = 'OUT OF STOCK';\n116:       else if (item.quantity < 10) stockStatus = 'LOW STOCK';\n117: \n118:       if (batchStatus === 'EXPIRED') stockStatus = 'EXPIRED';\n119: \n120:       return {\n121:         id: item._id,\n122:         medicine: med\n123:           ? {\n124:               id: med._id,\n125:               name: med.name,\n126:               genericName: med.genericName,\n127:               dosageForm: med.dosageForm,\n128:               strength: med.strength,\n129:               manufacturer: med.manufacturer,\n130:               referencePrice: med.referencePrice,\n131:             }\n132:           : null,\n133:         batch: batch\n134:           ? {\n135:               id: batch._id,\n136:               batchNumber: batch.batchNumber,\n137:               manufacturingDate: batch.manufacturingDate,\n138:               expiryDate: batch.expiryDate,\n139:               status: batchStatus,\n140:               daysToExpiry,\n141:             }\n142:           : null,\n143:         quantity: item.quantity,\n144:         purchasePrice: item.purchasePrice,\n145:         sellingPrice: item.sellingPrice,\n146:         stockStatus,\n147:         updatedAt: item.updatedAt,\n148:       };\n149:     });\n150: \n151:     await logAccess({\n152:       req,\n153:       action: 'VIEW_PHARMACY',\n154:       resourceType: 'Pharmacy',\n155:       resourceId: pharmacy._id,\n156:       details: `Viewed pharmacy details: ${pharmacy.name}`,\n157:     });\n158: \n159:     res.json({\n160:       success: true,\n161:       data: {\n162:         pharmacy,\n163:         stock: stockItems,\n164:         totalItems: stockItems.length,\n165:       },\n166:     });\n167:   } catch (err) {\n168:     res.status(500).json({ success: false, message: err.message });\n169:   }\n170: });\n171: \n172: // @route   PUT /api/pharmacies/:id\n173: // @desc    Update pharmacy profile (Pharmacy owner or Admin)\n174: // @access  Private\n175: router.put('/:id', protect, async (req, res) => {\n176:   try {\n177:     const pharmacy = await Pharmacy.findById(req.params.id);\n178:     if (!pharmacy) {\n179:       return res.status(404).json({ success: false, message: 'Pharmacy not found' });\n180:     }\n181: \n182:     // Check ownership or admin\n183:     if (req.user.role !== 'admin' && String(pharmacy.userId) !== String(req.user._id)) {\n184:       return res.status(403).json({ success: false, message: 'Not authorized to update this pharmacy' });\n185:     }\n186: \n187:     const { name, phone, address, area, openingHours, isOpenNow } = req.body;\n188:     if (name) pharmacy.name = name;\n189:     if (phone) pharmacy.phone = phone;\n190:     if (address) pharmacy.address = address;\n191:     if (area) pharmacy.area = area;\n192:     if (openingHours) pharmacy.openingHours = openingHours;\n193:     if (typeof isOpenNow === 'boolean') pharmacy.isOpenNow = isOpenNow;\n194: \n195:     await pharmacy.save();\n196: \n197:     await logAccess({\n198:       req,\n199:       action: 'UPDATE_PHARMACY',\n200:       resourceType: 'Pharmacy',\n201:       resourceId: pharmacy._id,\n202:       details: `Updated pharmacy: ${pharmacy.name}`,\n203:     });\n204: \n205:     res.json({\n206:       success: true,\n207:       message: 'Pharmacy details updated',\n208:       data: pharmacy,\n209:     });\n210:   } catch (err) {\n211:     res.status(500).json({ success: false, message: err.message });\n212:   }\n213: });\n214: \n215: module.exports = router;\n216: \nThe above content shows the entire, complete file contents of the requested file.\n"}
