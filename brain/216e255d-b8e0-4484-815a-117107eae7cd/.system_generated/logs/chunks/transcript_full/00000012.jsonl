s.map(item => `\n105:           <tr>\n106:             <td>\n107:               <strong class=\"text-navy\">${item.medicineName}</strong>\n108:               <div class=\"small text-muted\">${item.genericName || ''}</div>\n109:             </td>\n110:             <td>${item.manufacturer || 'N/A'}</td>\n111:             <td class=\"font-monospace small\">${item.batchNumber || 'N/A'}</td>\n112:             <td>\n113:               <span class=\"badge ${item.type === 'PURCHASE' ? 'bg-success' : 'bg-primary'}\">${item.type}</span>\n114:             </td>\n115:             <td>\n116:               <span class=\"status-pill match\">${item.verificationStatus}</span>\n117:             </td>\n118:             <td>${item.pharmacyName || '<span class=\"text-muted small\">MedCheck BD Search</span>'}</td>\n119:             <td class=\"small text-muted\">${formatDate(item.checkedAt)}</td>\n120:             <td class=\"text-end\">\n121:               ${item.medicineId ? `\n122:                 <a href=\"medicine-details.html?id=${item.medicineId._id || item.medicineId}\" class=\"btn btn-outline-primary btn-sm py-0 px-2 me-1\">\n123:                   View\n124:                 </a>\n125:               ` : ''}\n126:               <button class=\"btn btn-outline-danger btn-sm py-0 px-2\" onclick=\"deleteHistoryItem('${item._id}')\">\n127:                 <i class=\"fas fa-trash-alt\"></i>\n128:               </button>\n129:             </td>\n130:           </tr>\n131:         `).join('');\n132:       } catch (err) {\n133:         showToast(err.message, 'danger');\n134:       }\n135:     }\n136: \n137:     async function deleteHistoryItem(id) {\n138:       try {\n139:         const res = await fetch(`/api/history/${id}`, {\n140:           method: 'DELETE',\n141:           headers: getAuthHeaders(),\n142:         });\n143:         const data = await res.json();\n144:         if (!res.ok) throw new Error(data.message);\n145: \n146:         showToast('Record deleted from history', 'inf