     name,\n36:       email: email.toLowerCase(),\n37:       phone,\n38:       password,\n39:       role: assignedRole,\n40:     });\n41: \n42:     const token = generateToken(user._id);\n43: \n44:     await logAccess({\n45:       req,\n46:       action: 'REGISTER',\n47:       resourceType: 'Auth',\n48:       resourceId: user._id,\n49:       details: `Registered user: ${user.name} (${user.role})`,\n50:     });\n51: \n52:     res.status(201).json({\n53:       success: true,\n54:       message: 'Registration successful',\n55:       token,\n56:       user: {\n57:         id: user._id,\n58:         name: user.name,\n59:         email: user.email,\n60:         phone: user.phone,\n61:         role: user.role,\n62:       },\n63:     });\n64:   } catch (err) {\n65:     res.status(500).json({ success: false, message: err.message });\n66:   }\n67: });\n68: \n69: // @route   POST /api/auth/pharmacy-register\n70: // @desc    Register a Pharmacy with License (Pending approval)\n71: // @access  Public\n72: router.post('/pharmacy-register', async (req, res) => {\n73:   try {\n74:     const {\n75:       pharmacyName,\n76:       ownerName,\n77:       email,\n78:       phone,\n79:       password,\n80:       address,\n81:       area,\n82:       division,\n83:       licenseNumber,\n84:       openingHours,\n85:     } = req.body;\n86: \n87:     if (!pharmacyName || !ownerName || !email || !phone || !password || !address || !area || !licenseNumber) {\n88:       return res.status(400).json({ success: false, message: 'Please provide all required pharmacy details' });\n89:     }\n90: \n91:     const existingUser = await User.findOne({ email: email.toLowerCase() });\n92:     if (existingUser) {\n93:       return res.status(400).json({ success: false, message: 'An account with this email already exists' });\n94:     }\n95: \n96:     const existingPharmacy = await Pharmacy.findOne({ licenseNumber: licenseNumber.trim().toUpperCase() });\n97:     if (existingPharmacy) {\n98:       return res.status(400).json({ success: false, message: 'A pharmacy with this license number already exists' });\n99:     }\n100: \n101:     // Create user with role 'pharmacy'\n102:     const user = await User.create({\n103:       name: ownerName,\n104:       email: email.toLowerCase(),\n105:       phone,\n106:       password,\n107:       role: 'pharmacy',\n108:     });\n109: \n110:     // Create pharmacy record with status 'Pending'\n111:     const pharmacy = await Pharmacy.create({\n112:       name: pharmacyName,\n113:       ownerName,\n114:       phone,\n115:       email: email.toLowerCase(),\n116:       address,\n117:       area,\n118:       division: division || 'Dhaka',\n119:       licenseNumber: licenseNumber.trim().toUpperCase(),\n120:       verified: false,\n121:       status: 'Pending',\n122:       openingHours: openingHours || '8:00 AM - 11:00 PM',\n123:       userId: user._id,\n124:     });\n125: \n126:     const token = generateToken(user._id);\n127: \n128:     await logAccess({\n129:       req,\n130:       action: 'REGISTER_PHARMACY',\n131:       resourceType: 'Pharmacy',\n132:       resourceId: pharmacy._id,\n133:       details: `New pharmacy registered: ${pharmacy.name}, License: ${pharmacy.licenseNumber}`,\n134:     });\n135: \n136:     res.status(201).json({\n137:       success: true,\n138:       message: 'Pharmacy registered successfully! Your account is currently Pending Admin Verification.',\n139:       token,\n140:       user: {\n141:         id: user._id,\n142:         name: user.name,\n143:         email: user.email,\n144:         phone: user.phone,\n145:         role: user.role,\n146:       },\n147:       pharmacy: {\n148:         id: pharmacy._id,\n149:         name: pharmacy.name,\n150:         status: pharmacy.status,\n151:         verified: pharmacy.verified,\n152:         licenseNumber: pharmacy.licenseNumber,\n153:         area: pharmacy.area,\n154:       },\n155:     });\n156:   } catch (err) {\n157:     res.status(500).json({ success: false, message: err.message });\n158:   }\n159: });\n160: \n161: // @route   POST /api/auth/login\n162: // @desc    Authenticate User & Return Token\n163: // @access  Public\n164: router.post('/login', async (req, res) => {\n165:   try {\n166:     const { email, password } = req.body;\n167: \n168:     if (!email || !password) {\n169:       return res.status(400).json({ success: false, message: 'Please provide email and password' });\n170:     }\n171: \n172:     const user = await User.findOne({ email: email.toLowerCase() }).select('+password');\n173:     if (!user) {\n174:       return res.status(401).json({ success: false, message: 'Invalid email or password' });\n175:     }\n176: \n177:     const isMatch = await user.comparePassword(password);\n178:     if (!isMatch) {\n179:       return res.status(401).json({ success: false, message: 'Invalid email or password' });\n180:     }\n181: \n182:     let pharmacyInfo = null;\n183:     if (user.role === 'pharmacy') {\n184:       pharmacyInfo = await Pharmacy.findOne({ userId: user._id });\n185:     }\n186: \n187:     const token = generateToken(user._id);\n188: \n189:     await logAccess({\n190:       req,\n191:       action: 'LOGIN',\n192:       resourceType: 'Auth',\n193:       resourceId: user._id,\n194:       details: `User logged in: ${user.email} (${user.role})`,\n195:     });\n196: \n197:     res.json({\n198:       success: true,\n199:       message: 'Login successful',\n200:       token,\n201:       user: {\n202:         id: user._id,\n203:         name: user.name,\n204:         email: user.email,\n205:         phone: user.phone,\n206:         role: user.role,\n207:       },\n208:       pharmacy: pharmacyInfo,\n209:     });\n210:   } catch (err) {\n211:     res.status(500).json({ success: false, message: err.message });\n212:   }\n213: });\n214: \n215: // @route   GET /api/auth/me\n216: // @desc    Get Current Logged-in User\n217: // @access  Private\n218: router.get('/me', protect, async (req, res) => {\n219:   try {\n220:     let pharmacyInfo = null;\n221:     if (req.user.role === 'pharmacy') {\n222:       pharmacyInfo = await Pharmacy.findOne({ userId: req.user._id });\n223:     }\n224: \n225:     res.json({\n226:       success: true,\n227:       user: {\n228:         id: req.user._id,\n229:         name: req.user.name,\n230:         email: req.user.email,\n231:         phone: req.user.phone,\n232:         role: req.user.role,\n233:         createdAt: req.user.createdAt,\n234:       },\n235:       pharmacy: pharmacyInfo,\n236:     });\n237:   } catch (err) {\n238:     res.status(500).json({ success: false, message: err.message });\n239:   }\n240: });\n241: \n242: module.exports = router;\n243: \nThe above content shows the entire, complete file contents of the requested file.\n"}
