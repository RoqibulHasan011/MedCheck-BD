:       console.error('[Database] Failed to start in-memory MongoDB fallback:', memErr.message);\n33:       process.exit(1);\n34:     }\n35:   }\n36: };\n37: \n38: const closeDB = async () => {\n39:   await mongoose.connection.close();\n40:   if (mongod) {\n41:     await mongod.stop();\n42:   }\n43: };\n44: \n45: module.exports = { connectDB, closeDB };\n46: \nThe above content shows the entire, complete file contents of the requested file.\n"}
