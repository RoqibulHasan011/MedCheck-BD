Care Pharmacy</button>\n          <button type=\"button\" class=\"btn btn-light btn-sm border text-dark py-0 px-2\" onclick=\"quickFilterPharmacy('Lazz Pharma')\">Lazz Pharma</button>\n          <button type=\"button\" class=\"btn btn-light btn-sm border text-dark py-0 px-2\" onclick=\"quickFilterPharmacy('Tamanna')\">Tamanna Mirpur</button>\n          <button type=\"button\" class=\"btn btn-light btn-sm border text-dark py-0 px-2\" onclick=\"quickFilterPharmacy('Popular')\">Popular Uttara</button>\n          <button type=\"button\" class=\"btn btn-link btn-sm text-danger p-0 ms-auto text-decoration-none\" onclick=\"resetPharmacyFilters()\">\n            <i class=\"fas fa-undo-alt me-1\"></i> Reset Filters\n          </button>\n        </div>\n      </div>\n\n      <!-- Pharmacy Cards Grid -->\n      <div class=\"row\" id=\"pharmacyList\">\n        <!-- Loaded dynamically via js/pharmacy.js -->\n      </div>\n    </div>\n  </main>\n\n  <!-- Dynamic Footer -->\n  <div id=\"mainFooter\"></div>\n\n  <!-- Scripts -->\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n  <script src=\"js/main.js\"></script>\n  <script src=\"js/auth.js\"></script>\n  <script src=\"js/pharmacy.js\"></script>\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const urlParams = new URLSearchParams(window.location.search);\n      const med = urlParams.get('medicine');\n      if (med) {\n        const medInput = document.getElementById('filterMedicine');\n        if (medInput) medInput.value = decodeURIComponent(med);\n      }\n      const phm = urlParams.get('pharmacy');\n      if (phm) {\n        const phmInput = document.getElementById('searchPharmacy');\n        if (phmInput) phmInput.value = decodeURIComponent(phm);\n      }\n\n      // Attach autocompletes\n      setupMedicineAutocomplete('filterMedicine', () => loadPharmacies());\n      setupPharmacyAutocomplete('searchPharmacy', () => loadPharmacies());\n