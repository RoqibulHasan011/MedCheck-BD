{"step_index":561,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T20:24:50Z","content":"Created At: 2026-09-11T02:24:50+06:00\nCompleted At: 2026-09-11T02:24:50+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/client/js/pharmacy.js`\nTotal Lines: 272\nTotal Bytes: 11841\nShowing lines 140 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n140:       </div>\n141:     `;\n142:   }\n143: }\n144: \n145: function quickFilterPharmacy(name) {\n146:   const searchInput = document.getElementById('searchPharmacy');\n147:   if (searchInput) searchInput.value = name;\n148:   loadPharmacies();\n149: }\n150: \n151: function setAreaFilter(areaName) {\n152:   const areaSelect = document.getElementById('filterArea');\n153:   if (areaSelect) areaSelect.value = areaName;\n154:   loadPharmacies();\n155: }\n156: \n157: function resetPharmacyFilters() {\n158:   const areaSelect = document.getElementById('filterArea');\n159:   const searchInput = document.getElementById('searchPharmacy');\n160:   const medicineInput = document.getElementById('filterMedicine');\n161:   if (areaSelect) areaSelect.value = 'All Areas';\n162:   if (searchInput) searchInput.value = '';\n163:   if (medicineInput) medicineInput.value = '';\n164:   loadPharmacies();\n165: }\n166: \n167: // Load pharmacy details on pharmacy-details.html\n168: async function loadPharmacyDetails() {\n169:   const urlParams = new URLSearchParams(window.location.search);\n170:   const pharmacyId = urlParams.get('id');\n171:   const profileContainer = document.getElementById('pharmacyProfileArea');\n172:   const stockTableBody = document.getElementById('stockTableBody');\n173: \n174:   if (!pharmacyId) {\n175:     if (profileContainer) {\n176:       profileContainer.innerHTML = `\n177:         <div class=\"alert alert-warning\">No pharmacy specified. Please select a pharmacy from the directory.</div>\n178:       `;\n179:     }\n180:     return;\n181:   }\n182: \n183:   try {\n184:     const res = await fetch(`/api/pharmacies/${pharmacyId}`);\n185:     const data = await res.json();\n186: \n187:     if (!data.success || !data.data) {\n188:       throw new Error(data.message || 'Pharmacy not found');\n189:     }\n190: \n191:     const { pharmacy, stock } = data.data;\n192: \n193:     if (profileContainer) {\n194:       profileContainer.innerHTML = `\n195:         <div class=\"card-custom p-4 mb-4\">\n196:           <div class=\"row align-items-center\">\n197:             <div class=\"col-lg-8\">\n198:               <div class=\"d-flex align-items-center gap-2 mb-2\">\n199:                 <h3 class=\"fw-bold mb-0 text-navy\">${pharmacy.name}</h3>\n200:                 <span class=\"status-pill ${pharmacy.verified ? 'verified' : 'review'}\">\n201:                   ${pharmacy.verified ? '<i class=\"fas fa-check-circle me-1\"></i> VERIFIED PHARMACY' : '<i class=\"fas fa-clock me-1\"></i> PENDING VERIFICATION'}\n202:                 </span>\n203:               </div>\n204:               <p class=\"text-secondary mb-2\">\n205:                 <i class=\"fas fa-map-marker-alt text-danger me-2\"></i><strong>${pharmacy.area}, ${pharmacy.division}:</strong> ${pharmacy.address}\n206:               </p>\n207:               <div class=\"d-flex flex-wrap gap-4 text-secondary small\">\n208:                 <span><i class=\"fas fa-id-card text-primary me-1\"></i> <strong>Drug License:</strong> ${pharmacy.licenseNumber}</span>\n209:                 <span><i class=\"fas fa-user-tie text-secondary me-1\"></i> <strong>Manager:</strong> ${pharmacy.ownerName}</span>\n210:                 <span><i class=\"fas fa-phone-alt text-success me-1\"></i> ${pharmacy.phone}</span>\n211:                 <span><i class=\"fas fa-clock text-warning me-1\"></i> ${pharmacy.openingHours}</span>\n212:               </div>\n213:             </div>\n214:             <div class=\"col-lg-4 text-lg-end mt-3 mt-lg-0\">\n215:               <a href=\"tel:${pharmacy.phone}\" class=\"btn btn-primary-custom btn-sm me-2\">\n216:                 <i class=\"fas fa-phone-alt me-1\"></i> Contact Pharmacy\n217:               </a>\n218:               <a href=\"report.html?pharmacy=${encodeURIComponent(pharmacy.name)}\" class=\"btn btn-outline-danger btn-sm\">\n219:                 <i class=\"fas fa-flag me-1\"></i> Report Issue\n220:               </a>\n221:             </div>\n222:           </div>\n223:         </div>\n224:       `;\n225:     }\n226: \n227:     if (stockTableBody) {\n228:       if (!stock || stock.length === 0) {\n229:         stockTableBody.innerHTML = `\n230:           <tr>\n231:             <td colspan=\"7\" class=\"text-center py-4 text-muted\">No medicines currently listed in this pharmacy's digital inventory.</td>\n232:           </tr>\n233:         `;\n234:         return;\n235:       }\n236: \n237:       stockTableBody.innerHTML = stock\n238:         .map((item) => {\n239:           let statusBadgeClass = 'instock';\n240:           if (item.stockStatus === 'LOW STOCK') statusBadgeClass = 'lowstock';\n241:           else if (item.stockStatus === 'OUT OF STOCK' || item.stockStatus === 'EXPIRED') statusBadgeClass = 'expired';\n242: \n243:           return `\n244:           <tr>\n245:             <td>\n246:               <strong class=\"text-navy\">${item.medicine ? item.medicine.name : 'Unknown'}</strong>\n247:               <div class=\"small text-muted\">${item.medicine ? item.medicine.genericName : ''}</div>\n248:             </td>\n249:             <td><span class=\"badge bg-light text-dark border\">${item.medicine ? item.medicine.dosageForm : 'Tablet'}</span></td>\n250:             <td class=\"font-monospace small\">${item.batch ? item.batch.batchNumber : 'N/A'}</td>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
