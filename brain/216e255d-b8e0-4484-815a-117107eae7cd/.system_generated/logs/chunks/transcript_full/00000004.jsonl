\">\n        <div class=\"col-lg-3 col-sm-6\">\n          <div class=\"card-custom p-3 bg-white\">\n            <div class=\"d-flex align-items-center justify-content-between\">\n              <div>\n                <span class=\"text-muted small fw-bold\">Total Stocked</span>\n                <h3 class=\"fw-bold text-navy mb-0 mt-1\" id=\"statTotalMedicines\">0</h3>\n              </div>\n              <div class=\"rounded-circle bg-primary bg-opacity-10 text-primary p-3\">\n                <i class=\"fas fa-boxes fa-lg\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-3 col-sm-6\">\n          <div class=\"card-custom p-3 bg-white\">\n            <div class=\"d-flex align-items-center justify-content-between\">\n              <div>\n                <span class=\"text-muted small fw-bold\">Low Stock (&lt;10)</span>\n                <h3 class=\"fw-bold text-warning mb-0 mt-1\" id=\"statLowStock\">0</h3>\n              </div>\n              <div class=\"rounded-circle bg-warning bg-opacity-10 text-warning p-3\">\n                <i class=\"fas fa-exclamation-triangle fa-lg\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-3 col-sm-6\">\n          <div class=\"card-custom p-3 bg-white\">\n            <div class=\"d-flex align-items-center justify-content-between\">\n              <div>\n                <span class=\"text-muted small fw-bold\">Expiring & Expired</span>\n                <h3 class=\"fw-bold text-danger mb-0 mt-1\" id=\"statExpiring\">0</h3>\n              </div>\n              <div class=\"rounded-circle bg-danger bg-opacity-10 text-danger p-3\">\n                <i class=\"fas fa-calendar-times fa-lg\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-3 col-sm-6\">\n          <div class=\"card-custom p-3 bg-white\">\n            <div class=\"d-flex align-items-center justify-content-between\">\n              <div>\n                <span class=\"text-muted small fw-bold\">Today's Transactions</span>\n                <h3 class=\"fw-bold text-success mb-0 mt-1\" id=\"statTodaySales\">Live</h3>\n              </div>\n              <div class=\"rounded-circle bg-success bg-opacity-10 text-success p-3\">\n                <i class=\"fas fa-receipt fa-lg\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Critical Alerts Panel -->\n      <div class=\"card-custom p-3 bg-white mb-4\">\n        <h6 class=\"fw-bold text-navy mb-2\"><i class=\"fas fa-bell text-danger me-2\"></i>Inventory & Expiry Safety Alerts</h6>\n        <div id=\"pharmacyAlertsContainer\">\n          <div class=\"text-center py-2 text-muted small\">Checking stock and batch expiry thresholds...</div>\n        </div>\n      </div>\n\n      <!-- Inventory Table -->\n      <div class=\"card-custom p-4 bg-white mb-4\">\n        <div class=\"d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2\">\n          <div>\n            <h5 class=\"fw-bold text-navy mb-0\"><i class=\"fas fa-warehouse text-primary me-2\"></i>Current Medicine Inventory</h5>\n            <small class=\"text-muted\">Live stock quantities, purchase/selling prices, and batch audit status.</small>\n          </div>\n          <button class=\"btn btn-outline-secondary btn-sm\" onclick=\"loadPharmacyStatsAndInventory()\">\n            <i class=\"fas fa-sync-alt me-1\"></i> Refresh Stock\n          </button>\n        </div>\n\n        <div class=\"table-responsive\">\n          <table class=\"table table-custom align-middle mb-0\">\n            <thead>\n              <tr>\n                <th>Medicine & Generic</th>\n                <th>Batch No</th>\n                <th>Expiry Date</th>\n                <th>Units In Stock</th>\n                <th>Purchase (৳)</th>\n                <th>Selling (৳)</th>\n                <th>Status</th>\n                <th class=\"text-end\">Actions</th>\n              </tr>\n            </thead>\n            <tbody id=\"inventoryTableBody\">\n              <tr><td colspan=\"8\" class=\"text-center py-4 text-muted\">Loading inventory records...</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <!-- MODAL: Add Inventory Stock -->\n  <div class=\"modal fade\" id=\"addInventoryModal\" tabindex=\"-1\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n      <div class=\"modal-content border-0 shadow-lg\">\n        <div class=\"modal-header bg-primary text-white\">\n          <h5 class=\"modal-title fw-bold\"><i class=\"fas fa-plus-circle me-2\"></i>Add Medicine to Inventory</h5>\n          <button type=\"button\" class=\"btn-close btn-close-white\" data-bs-dismiss=\"modal\"></button>\n        </div>\n        <form id=\"addInventoryForm\" onsubmit=\"handleAddInventory(event)\">\n          <div class=\"modal-body\">\n            <div class=\"mb-3\">\n              <label class=\"form-label fw-bold text-navy small\">Select Medicine *</label>\n              <select id=\"addInvMedicineSelect\" class=\"form-select\" required>\n                <option value=\"\">Loading medicines...</option>\n              </select>\n            </div>\n            <div class=\"row g-2 mb-3\">\n              <div class=\"col-6\">\n                <label class=\"form-label fw-bold text-navy small\">Batch Number *</label>\n                <input type=\"text\" id=\"addInvBatchNumber\" class=\"form-control font-monospace\" placeholder=\"e.g. NP-2026-05\" required>\n              </div>\n              <div class=\"col-6\">\n                <label class=\"form-label fw-bold text-navy small\">Expiry Date *</label>\n                <input type=\"date\" id=\"addInvExpiryDate\" class=\"form-control\" required>\n              </div>\n            </div>\n            <div class=\"row g-2 mb-3\">\n              <div class=\"col-4\">\n                <label class=\"form-label fw-bold text-navy small\">Quantity *</label>\n                <input type=\"number\" id=\"addInvQuantity\" class=\"form-control\" placeholder=\"50\" min=\"1\" required>\n              </div>\n              <div class=\"col-4\">\n                <label class=\"form-label fw-bold text-navy small\">Purchase ৳</label>\n                <input type=\"number\" step=\"0.01\" id=\"addInvPurchasePrice\" class=\"form-control\" placeholder=\"1.00\">\n              </div>\n              <div class=\"col-4\">\n                <label class=\"form-label fw-bold text-navy small\">Selling ৳ *</label>\n                <input type=\"number\" step=\"0.01\" id=\"addInvSellingPrice\" class=\"form-control\" placeholder=\"1.20\" required>\n              </div>\n            </div>\n          </div>\n          <div class=\"modal-footer\">\n            <button type=\"button\" class=\"btn btn-light btn-sm\" data-bs-dismiss=\"modal\">Cancel</button>\n            <button type=\"submit\" class=\"btn btn-primary-custom btn-sm\">Save to Stock</button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: Edit Inventory Item -->\n  <div class=\"modal fade\" id=\"editInventoryModal\" tabindex=\"-1\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n      <div class=\"modal-content border-0 shadow-lg\">\n        <div class=\"modal-header bg-navy-dark text-white\">\n          <h5 class=\"modal-title fw-bold\"><i class=\"fas fa-edit me-2\"></i>Update Stock & Price</h5>\n          <button type=\"button\" class=\"btn-close btn-close-white\" data-bs-dismiss=\"modal\"></button>\n        </div>\n        <form onsubmit=\"handleUpdateInventory(event)\">\n          <input type=\"hidden\" id=\"editInvId\">\n          <div class=\"modal-body\">\n            <div class=\"mb-3\">\n              <label class=\"form-label fw-bold text-navy small\">Available Quantity</label>\n              <input type=\"number\" id=\"editInvQuantity\" class=\"form-control\" min=\"0\" required>\n            </div>\n            <div class=\"row g-2 mb-3\">\n              <div class=\"col-6\">\n                <label class=\"form-label fw-bold text-navy small\">Purchase Price (৳)</label>\n                <input type=\"number\" step=\"0.01\" id=\"editInvPurchasePrice\" class=\"form-control\" required>\n              </div>\n              <div class=\"col-6\">\n                <label class=\"form-label fw-bold text-navy small\">Selling Price (৳)</label>\n                <input type=\"number\" step=\"0.01\" id=\"editInvSellingPrice\" class=\"form-control\" required>\n              </div>\n            </div>\n          </div>\n          <div class=\"modal-footer\">\n            <button type=\"button\" class=\"btn btn-light btn-sm\" data-bs-dismiss=\"modal\">Cancel</button>\n            <button type=\"submit\" class=\"btn btn-primary-custom btn-sm\">Save Changes</button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: Record Sale / POS System -->\n  <div class=\"modal fade\" id=\"recordSaleModal\" tabindex=\"-1\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-dialog-centered modal-lg\">\n      <div class=\"modal-content border-0 shadow-lg\">\n        <div class=\"modal-header bg-success text-white\">\n          <h5 class=\"modal-title fw-bold\"><i class=\"fas fa-cash-register me-2\"></i>Record New Sale & Issue Digital Receipt</h5>\n          <button type=\"button\" class=\"btn-close btn-close-white\" data-bs-dismiss=\"modal\"></button>\n        </div>\n        <form id=\"posSaleForm\" onsubmit=\"handleRecordSale(event)\">\n          <div class=\"modal-body\">\n            <div class=\"row g-3 mb-3\">\n              <div class=\"col-md-6\">\n                <label class=\"form-label fw-bold text-navy small\">Customer Name (Optional)</label>\n                <input type=\"text\" id=\"posCustomerName\" class=\"form-control\" placeholder=\"Walk-in Customer\">\n              </div>\n              <div class=\"col-md-6\">\n                <label class=\"form-label fw-bold text-navy small\">Customer Mobile (For history linkage)</label>\n                <input type=\"tel\" id=\"posCustomerPhone\" class=\"form-control\" placeholder=\"+8801711000000\">\n              </div>\n            </div>\n\n            <div class=\"mb-3\">\n              <label class=\"form-label fw-bold text-navy small\">Customer Email (Optional)</label>\n              <input type=\"email\" id=\"posCustomerEmail\" class=\"form-control\" placeholder=\"e.g. customer@gmail.com\">\n            </div>\n\n            <hr class=\"my-3\">\n\n            <div class=\"row g-3 mb-3\">\n              <div class=\"col-md-6\">\n                <label class=\"form-label fw-bold text-navy small\">Dispense Medicine *</label>\n                <select id=\"posMedicineSelect\" class=\"form-select\" required>\n                  <option value=\"\">Select Medicine...</option>\n                </select>\n              </div>\n              <div class=\"col-md-3\">\n                <label class=\"form-label fw-bold text-navy small\">Batch Code</label>\n                <input type=\"text\" id=\"posBatchNumber\" class=\"form-control font-monospace\" placeholder=\"e.g. NAPA-2026-01\">\n              </div>\n              <div class=\"col-md-3\">\n                <label class=\"form-label fw-bold text-navy small\">Quantity *</label>\n                <input type=\"number\" id=\"posQuantity\" class=\"form-control\" min=\"1\" value=\"1\" required>\n              </div>\n            </div>\n\n            <div class=\"row g-3\">\n              <div class=\"col-md-6\">\n                <label class=\"form-label fw-bold text-navy small\">Payment Mode</label>\n                <select id=\"posPaymentMethod\" class=\"form-select\">\n                  <option value=\"Cash\">Cash</option>\n                  <option value=\"bKash\">bKash</option>\n                  <option value=\"Nagad\">Nagad</option>\n                  <option value=\"Card\">Debit / Credit Card</option>\n                </select>\n              </div>\n              <div class=\"col-md-6\">\n                <label class=\"form-label fw-bold text-navy small\">Discount (৳)</label>\n                <input type=\"number\" step=\"0.5\" id=\"posDiscount\" class=\"form-control\" value=\"0\">\n              </div>\n            </div>\n          </div>\n          <div class=\"modal-footer\">\n            <button type=\"button\" class=\"btn btn-light btn-sm\" data-bs-dismiss=\"modal\">Close</button>\n            <button type=\"submit\" id=\"recordSaleBtn\" class=\"btn btn-success-custom btn-sm\">\n              <i class=\"fas fa-receipt me-1\"></i> Complete Sale & Print Receipt\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n\n  <!-- Dynamic Footer -->\n  <div id=\"mainFooter\"></div>\n\n  <!-- Scripts -->\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n  <script src=\"js/main.js\"></script>\n  <script src=\"js/auth.js\"></script>\n  <script src=\"js/inventory.js\"></script>\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      initPharmacyDashboard();\n    });\n  </script>\n</body>\n</html>\n","Description":"Create Pharmacy Dashboard (pharmacy-dashboard.html) with inventory CRUD, POS sale modal and alerts","Overwrite":true,"TargetFile":"C:\\Users\\User\\.gemini\\antigravity\\scratch\\medcheck-bd\\client\\pharmacy-dashboard.html","toolAction":"Create client/pharmacy-dashboard.html","toolSummary":"Create pharmacy-dashboard.html"}}]}
