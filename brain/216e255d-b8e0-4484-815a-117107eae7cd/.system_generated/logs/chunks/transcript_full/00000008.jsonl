ric, batch or barcode', 'warning');\n38:     return;\n39:   }\n40: \n41:   await executeVerification(query);\n42: }\n43: \n44: async function executeVerification(query) {\n45:   const resultContainer = document.getElementById('verifyResultArea');\n46:   const searchBtn = document.getElementById('verifySearchBtn');\n47: \n48:   if (!resultContainer) return;\n49: \n50:   if (searchBtn) {\n51:     searchBtn.disabled = true;\n52:     searchBtn.innerHTML = '<span class=\"spinner-border spinner-border-sm me-2\"></span>Checking records...';\n53:   }\n54: \n55:   resultContainer.innerHTML = `\n56:     <div class=\"text-center py-5\">\n57:       <div class=\"spinner-border text-primary\" style=\"width: 3rem; height: 3rem;\" role=\"status\"></div>\n58:       <p class=\"mt-3 text-muted fw-bold\">Cross-referencing MedCheck BD Reference Database...</p>\n59:     </div>\n60:   `;\n61: \n62:   try {\n63:     const token = localStorage.getItem('token');\n64:     const headers = { 'Content-Type': 'application/json' };\n65:     if (token) headers.Authorization = `Bearer ${token}`;\n66: \n67:     const res = await fetch(`/api/verify/${encodeURIComponent(query)}`, { headers });\n68:     const data = await res.json();\n69: \n70:     if (!data.success || !data.matchFound) {\n71:       renderNotFoundResult(query, data);\n72:       return;\n73:     }\n74: \n75:     renderMatchResult(data);\n76:   } catch (err) {\n77:     resultContainer.innerHTML = `\n78:       <div class=\"alert alert-danger shadow-sm border-0\" role=\"alert\">\n79:         <i class=\"fas fa-exclamation-triangle me-2\"></i> Verification query failed: ${err.message}\n80:       </div>\n81:     `;\n82:   } finally {\n83:     if (searchBtn) {\n84:       searchBtn.disabled = false;\n85:       searchBtn.innerHTML = '<i class=\"fas fa-search me-2\"></i>Verify Medicine';\n86:     }\n87:   }\n88: }\n89: \n90: function renderNotFoundResult(query, data) {\n91:   const resultContainer = document.getElementById('verifyResultArea');\n92: \n93:   let suggestionsHtml = '';\n94:   if (data.suggestions && data.suggestions.length > 0) {\n95:     suggestionsHtml = `\n96:       <div class=\"mt-4 pt-3 border-top\">\n97:         <h6 class=\"fw-bold text-navy mb-2\"><i class=\"fas fa-lightbulb text-warning me-2\"></i>Did you mean one of these registered medicines?</h6>\n98:         <div class=\"d-flex flex-wrap gap-2\">\n99:           ${data.suggestions\n100:             .map(\n101:               (s) => `\n102:             <button type=\"button\" class=\"btn btn-outline-primary btn-sm\" onclick=\"document.getElementById('verifyInput').value='${s.name}'; executeVerification('${s.name}');\">\n103:               <i class=\"fas fa-pills me-1\"></i> ${s.name} <span class=\"text-muted small\">(${s.genericName})</span>\n104:             </button>\n105:           `\n106:             )\n107:             .join('')}\n108:         </div>\n109:       </div>\n110:     `;\n111:   }\n112: \n113:   resultContainer.innerHTML = `\n114:     <div class=\"card border-0 shadow-lg\" style=\"border-radius: 16px; overflow: hidden;\">\n115:       <div class=\"p-4\" style=\"background: linear-gradient(135deg, #dc2626, #ef4444); color: white;\">\n116:         <div class=\"d-flex align-items-center justify-content-between\">\n117:           <div class=\"d-flex align-items-center gap-3\">\n118:             <i class=\"fas fa-times-circle fa-2x\"></i>\n119:             <div>\n120:               <h4 class=\"mb-0 fw-bold\">No Exact Database Match Found</h4>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
