{"step_index":308,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T19:46:38Z","content":"Created At: 2026-09-11T01:46:38+06:00\nCompleted At: 2026-09-11T01:46:39+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/server/routes/verify.js`\nTotal Lines: 258\nTotal Bytes: 10099\nShowing lines 1 to 140\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const express = require('express');\n2: const router = express.Router();\n3: const Medicine = require('../models/Medicine');\n4: const Batch = require('../models/Batch');\n5: const Pharmacy = require('../models/Pharmacy');\n6: const Inventory = require('../models/Inventory');\n7: const MedicineHistory = require('../models/MedicineHistory');\n8: const { optionalAuth } = require('../middleware/auth');\n9: const { logAccess } = require('../middleware/logger');\n10: \n11: // @route   GET /api/verify/:query\n12: // @desc    Verify medicine by brand, generic, barcode, registration number or batch\n13: // @access  Public (Optional auth for history saving)\n14: router.get('/:query', optionalAuth, async (req, res) => {\n15:   try {\n16:     const rawQuery = decodeURIComponent(req.params.query || '').trim();\n17:     const batchParam = req.query.batch ? req.query.batch.trim() : null;\n18: \n19:     if (!rawQuery) {\n20:       return res.status(400).json({ success: false, message: 'Please provide a search term or identifier' });\n21:     }\n22: \n23:     // 1. Check if the query itself matches a Batch number directly\n24:     let batchMatch = await Batch.findOne({\n25:       batchNumber: { $regex: `^${rawQuery.trim()}$`, $options: 'i' },\n26:     }).populate('medicineId');\n27: \n28:     // 2. Search for matching medicine by direct regex\n29:     let medicine = null;\n30:     if (batchMatch && batchMatch.medicineId) {\n31:       medicine = batchMatch.medicineId;\n32:     } else {\n33:       const cleanRegex = rawQuery.replace(/[^\\w\\s]/gi, '');\n34:       medicine = await Medicine.findOne({\n35:         $or: [\n36:           { name: { $regex: `^${rawQuery.trim()}$`, $options: 'i' } },\n37:           { name: { $regex: cleanRegex, $options: 'i' } },\n38:           { genericName: { $regex: cleanRegex, $options: 'i' } },\n39:           { registrationNumber: { $regex: `^${rawQuery.trim()}$`, $options: 'i' } },\n40:           { barcode: { $regex: `^${rawQuery.trim()}$`, $options: 'i' } },\n41:           { manufacturer: { $regex: cleanRegex, $options: 'i' } },\n42:         ],\n43:       });\n44: \n45:       // If direct match failed, try smart tokenized search (e.g. \"napa 500mg\" or \"napa500\")\n46:       if (!medicine) {\n47:         const spaced = rawQuery\n48:           .replace(/([a-zA-Z]+)(\\d+)/g, '$1 $2')\n49:           .replace(/(\\d+)([a-zA-Z]+)/g, '$1 $2')\n50:           .replace(/[^\\w\\s]/gi, ' ');\n51: \n52:         const tokens = spaced\n53:           .split(/\\s+/)\n54:           .map((t) => t.replace(/(mg|ml|gm|mcg|iu)$/i, ''))\n55:           .filter((t) => t.length > 0);\n56: \n57:         if (tokens.length > 0) {\n58:           const tokenRegexes = tokens.map((t) => new RegExp(t, 'i'));\n59: \n60:           // Try matching all tokens in name, generic, strength or manufacturer\n61:           medicine = await Medicine.findOne({\n62:             $and: tokenRegexes.map((r) => ({\n63:               $or: [{ name: r }, { genericName: r }, { strength: r }, { manufacturer: r }],\n64:             })),\n65:           });\n66: \n67:           // If still not matched, try matching the first significant brand token\n68:           if (!medicine && tokens[0].length >= 3) {\n69:             medicine = await Medicine.findOne({\n70:               $or: [{ name: new RegExp(tokens[0], 'i') }, { genericName: new RegExp(tokens[0], 'i') }],\n71:             });\n72:           }\n73:         }\n74:       }\n75:     }\n76: \n77:     // If still no direct match, try finding batch if user provided batch as query param\n78:     if (medicine && batchParam && !batchMatch) {\n79:       batchMatch = await Batch.findOne({\n80:         medicineId: medicine._id,\n81:         batchNumber: { $regex: `^${batchParam.trim()}$`, $options: 'i' },\n82:       });\n83:     }\n84: \n85:     // If medicine was found, get its primary or most recent batch if none specified\n86:     let selectedBatch = batchMatch;\n87:     if (medicine && !selectedBatch) {\n88:       selectedBatch = await Batch.findOne({ medicineId: medicine._id }).sort({ expiryDate: -1 });\n89:     }\n90: \n91:     // If absolutely nothing matched:\n92:     if (!medicine && !batchMatch) {\n93:       // Find top registered suggestions to show the user\n94:       const suggestions = await Medicine.find()\n95:         .limit(4)\n96:         .select('name genericName strength manufacturer referencePrice');\n97: \n98:       await logAccess({\n99:         req,\n100:         action: 'VERIFY_MEDICINE',\n101:         resourceType: 'Medicine',\n102:         details: `Verification query with no direct match: \"${rawQuery}\"`,\n103:       });\n104: \n105:       return res.json({\n106:         success: true,\n107:         matchFound: false,\n108:         verificationStatus: 'NOT FOUND',\n109:         badgeColor: 'danger',\n110:         queriedTerm: rawQuery,\n111:         message: `No approved reference or registered batch found directly matching \"${rawQuery}\".`,\n112:         suggestions,\n113:         disclaimer: 'Absence from this database does not guarantee an unregistered medicine, but warrants careful consultation with a licensed pharmacist or physician.',\n114:       });\n115:     }\n116: \n117:     // Determine verification outcome\n118:     let verificationStatus = 'DATABASE MATCH';\n119:     let badgeColor = 'success';\n120:     let statusSummary = 'Database Match: Medicine details match official Bangladesh reference records.';\n121:     let alertMessages = [];\n122: \n123:     // Check Medicine Alerts\n124:     if (medicine.alerts && medicine.alerts.length > 0) {\n125:       verificationStatus = 'NEEDS REVIEW';\n126:       badgeColor = 'warning';\n127:       alertMessages.push(...medicine.alerts.map((a) => a.message));\n128:     }\n129: \n130:     // Check Registration Status\n131:     if (medicine.registrationStatus === 'NEEDS REVIEW') {\n132:       verificationStatus = 'NEEDS REVIEW';\n133:       badgeColor = 'warning';\n134:       statusSummary = 'Needs Review: Regulatory reference records show pending or flagged review status.';\n135:     } else if (medicine.registrationStatus === 'SUSPENDED' || medicine.registrationStatus === 'NOT FOUND') {\n136:       verificationStatus = 'ALERT DETECTED';\n137:       badgeColor = 'danger';\n138:       statusSummary = `Alert Detected: Medicine status listed as ${medicine.registrationStatus}.`;\n139:     }\n140: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
