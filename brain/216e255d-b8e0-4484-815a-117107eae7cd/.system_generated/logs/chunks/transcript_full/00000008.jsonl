31:         <form onsubmit=\"handlePriceSearch(event)\">\n32:           <label class=\"form-label fw-bold text-navy\">Search Medicine for Price Comparison</label>\n33:           <div class=\"input-group input-group-lg shadow-sm\">\n34:             <span class=\"input-group-text bg-white border-end-0 text-muted\"><i class=\"fas fa-tags\"></i></span>\n35:             <input\n36:               type=\"text\"\n37:               id=\"priceSearchInput\"\n38:               class=\"form-control border-start-0 ps-0\"\n39:               placeholder=\"e.g. Napa 500 mg, Seclo 20 mg, Maxpro 20 mg...\"\n40:               required\n41:             >\n42:             <button class=\"btn btn-primary-custom px-4\" type=\"submit\" id=\"priceSearchBtn\">\n43:               <i class=\"fas fa-search me-2\"></i>Check Prices\n44:             </button>\n45:           </div>\n46:           <div class=\"small text-muted mt-2\">\n47:             <i class=\"fas fa-lightbulb text-warning me-1\"></i> Suggestions:\n48:             <a href=\"javascript:void(0)\" onclick=\"searchPriceFor('Napa 500 mg')\" class=\"text-decoration-none me-2\">Napa 500 mg</a>\n49:             <a href=\"javascript:void(0)\" onclick=\"searchPriceFor('Seclo 20 mg')\" class=\"text-decoration-none me-2\">Seclo 20 mg</a>\n50:             <a href=\"javascript:void(0)\" onclick=\"searchPriceFor('Maxpro 20 mg')\" class=\"text-decoration-none me-2\">Maxpro 20 mg</a>\n51:             <a href=\"javascript:void(0)\" onclick=\"searchPriceFor('Ace Plus')\" class=\"text-decoration-none\">Ace Plus</a>\n52:           </div>\n53:         </form>\n54:       </div>\n55: \n56:       <!-- Price Comparison Results Area -->\n57:       <div id=\"priceComparisonArea\" class=\"mx-auto\" style=\"max-width: 960px;\">\n58:         <div class=\"text-center py-5 bg-white rounded-4 border p-4 shadow-sm\">\n59:           <div class=\"text-success opacity-75 mb-3\">\n60:             <i class=\"fas fa-chart-line fa-3x\"></i>\n61:           </div>\n62:           <h5 class=\"fw-bold text-navy\">Search Any Medicine to Compare Prices</h5>\n63:           <p class=\"text-muted small max-w-500 mx-auto\">\n64:             Discover which pharmacies in Dhaka, Dhanmondi, Mirpur, Uttara and divisional hubs offer the best rates within official DGDA guidelines.\n65:           </p>\n66:         </div>\n67:       </div>\n68: \n69:       <!-- Disclaimer -->\n70:       <div class=\"alert alert-light border text-muted small mt-5 mx-auto\" style=\"max-width: 960px;\">\n71:         <i class=\"fas fa-info-circle text-primary me-2\"></i>\n72:         <strong>Price Disclaimer:</strong> Prices may vary by pharmacy and location. Displayed prices reflect live inventory data submitted by registered pharmacies and reference/demo benchmarks. Always request a printed receipt from your dispensing pharmacy.\n73:       </div>\n74:     </div>\n75:   </main>\n76: \n77:   <!-- Dynamic Footer -->\n78:   <div id=\"mainFooter\"></div>\n79: \n80:   <!-- Scripts -->\n81:   <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n82:   <script src=\"js/main.js\"></script>\n83:   <script src=\"js/auth.js\"></script>\n84:   <script>\n85:     document.addEventListener('DOMContentLoaded', () => {\n86:       const urlParams = new URLSearchParams(window.location.search);\n87:       const medicine = urlParams.get('medicine');\n88:       if (medicine) {\n89:         const input = document.getElementById('priceSearchInput');\n90:         if (input) input.value = decodeURIComponent(medicine);\n91:         executePriceCheck(medicine);\n92:       }\n93:     });\n94: \n95:     function searchPriceFor(name) {\n96:       document.getElementById('priceSearchInput').value = name;\n97:       executePriceCheck(name);\n98:     }\n99: \n100:     function handlePriceSearch(e) {\n101:       e.preventDefault();\n102:       const query = document.getElementById('priceSearchInput').value.trim();\n103:       if (!query) return;\n104:       executePriceCheck(query);\n105:     }\n106: \n107:     async function executePriceCheck(query) {\n108:       const container = document.getElementById('priceComparisonArea');\n109:       const searchBtn = document.getElementById('priceSearchBtn');\n110: \n111:       if (searchBtn) {\n112:         searchBtn.disabled = true;\n113:         searchBtn.innerHTML = '<span class=\"spinner-border spinner-border-sm me-2\"></span>Searching...';\n114:       }\n115: \n116:       container.innerHTML = `\n117:         <div class=\"text-center py-5\">\n118:           <div class=\"spinner-border text-primary\" role=\"status\"></div>\n119:           <p class=\"text-muted mt-2\">Checking prices across verified pharmacies...</p>\n120:         </div>\n121:       `;\n122: \n123:       try {\n124:         const res = await fetch(`/api/inventory/compare?query=${encodeURIComponent(query)}`);\n125:         const data = await res.json();\n126: \n127:         if (!data.success || !data.matchFound) {\n128:           container.innerHTML = `\n129:             <div class=\"alert alert-warning border-0 p-4 shadow-sm text-center\">\n130:               <i class=\"fas fa-exclamation-triangle fa-2x mb-2 text-warning\"></i>\n131:               <h5 class=\"fw-bold\">No Medicine Found</h5>\n132:               <p class=\"text-muted mb-0\">No matching medicine found for \"${query}\". Try searching for popular brands like Napa, Seclo, or Maxpro.</p>\n133:             </div>\n134:           `;\n135:           return;\n136:         }\n137: \n138:         const { medicine, lowestPrice, data: items } = data;\n139: \n140:         let rowsHtml = '<tr><td colspan=\"6\" class=\"text-center py-4 text-muted\">No pharmacies have listed current inventory for this medicine yet.</td></tr>';\n141:         if (items && items.length > 0) {\n142:           rowsHtml = items.map(item => {\n143:             const isLowest = item.price === lowestPrice;\n144:             const diff = item.priceDifference;\n145:             let diffBadge = '<span class=\"badge bg-secondary\">Matches Ref</span>';\n146:             if (diff > 0) {\n147:               diffBadge = `<span class=\"badge bg-danger-subtle text-danger border border-danger-subtle\">+৳${diff.toFixed(2)} (+${item.priceDifferencePercentage}%)</span>`;\n148:             } else if (diff < 0) {\n149:               diffBadge = `<span class=\"badge bg-success-subtle text-success border border-success-subtle\">-৳${Math.abs(diff).toFixed(2)} (${item.priceDifferencePercentage}%)</span>`;\n150:             }\n151: \n152:             return `\n153:               <tr class=\"${isLowest ? 'table-success bg-opacity-25' : ''}\">\n154:                 <td>\n155:                   <a href=\"pharmacy-details.html?id=${item.pharmacy.id}\" class=\"fw-bold text-dark text-decoration-none\">\n156:                     ${item.pharmacy.name}\n157:                   </a>\n158:                   ${item.pharmacy.verified ? '<i class=\"fas fa-check-circle text-success small ms-1\" title=\"Verified Pharmacy\"></i>' : ''}\n159:                   <div class=\"small text-muted\"><i class=\"fas fa-map-marker-alt text-danger me-1\"></i>${item.pharmacy.area}</div>\n160:                 </td>\n161:                 <td>\n162:                   <span class=\"fs-5 fw-bold text-navy\">${formatBDT(item.price)}</span>\n163:                   ${isLowest ? '<span class=\"badge bg-success ms-2\"><i class=\"fas fa-star me-1\"></i>Lowest Price</span>' : ''}\n164:                 </td>\n165:                 <td>${diffBadge}</td>\n166:                 <td>\n167:                   <span class=\"badge ${item.status === 'Available' ? 'bg-success' : (item.status === 'Low Stock' ? 'bg-warning text-dark' : 'bg-danger')}\">\n168:                     ${item.status}\n169:                   </span>\n170:                 </td>\n171:                 <td class=\"small text-muted\">${formatDate(item.updatedAt)}</td>\n172:                 <td class=\"text-end\">\n173:                   <a href=\"pharmacy-details.html?id=${item.pharmacy.id}\" class=\"btn btn-outline-primary btn-sm py-1\">\n174:                     View Stock\n175:                   </a>\n176:                 </td>\n177:               </tr>\n178:             `;\n179:           }).join('');\n180:         }\n181: \n182:         container.innerHTML = `\n183:           <div class=\"card-custom p-4 mb-4\">\n184:             <!-- Medicine Info Banner -->\n185:             <div class=\"row align-items-center mb-4 border-bottom pb-3 g-3\">\n186:               <div class=\"col-md-7\">\n187:                 <span class=\"badge bg-primary-subtle text-primary fw-bold text-uppercase mb-1\">${medicine.dosageForm}</span>\n188:                 <h3 class=\"fw-bold text-navy mb-1\">${medicine.name}</h3>\n189:                 <div class=\"text-secondary\">${medicine.genericName} • ${medicine.strength}</div>\n190:                 <div class=\"small text-muted\">Manufacturer: <strong>${medicine.manufacturer}</strong></div>\n191:               </div>\n192:               <div class=\"col-md-5 text-md-end\">\n193:                 <div class=\"p-3 bg-light rounded-3 d-inline-block text-start text-md-end\">\n194:                   <div class=\"small text-muted\">DGDA Official Reference Benchmark</div>\n195:                   <div class=\"fs-3 fw-bold text-primary\">${formatBDT(medicine.referencePrice)}</div>\n196:                   <div class=\"small text-success fw-bold\">\n197:                     ${lowestPrice ? `Lowest available in store: ${formatBDT(lowestPrice)}` : ''}\n198:                   </div>\n199:                 </div>\n200:               </div>\n201:             </div>\n202: \n203:             <!-- Price Table -->\n204:             <h5 class=\"fw-bold text-navy mb-3\"><i class=\"fas fa-store text-primary me-2\"></i>Pharmacy Price Comparison</h5>\n205:             <div class=\"table-responsive\">\n206:               <table class=\"table table-custom align-middle mb-0\">\n207:                 <thead>\n208:                   <tr>\n209:                     <th>Pharmacy & Location</th>\n210:                     <th>Selling Price</th>\n211:                     <th>Variance vs Ref</th>\n212:                     <th>Availability</th>\n213:                     <th>Updated</th>\n214:                     <th class=\"text-end\">Action</th>\n215:                   </tr>\n216:                 </thead>\n217:                 <tbody>\n218:                   ${rowsHtml}\n219:                 </tbody>\n220:               </table>\n221:             </div>\n222:           </div>\n223:         `;\n224:       } catch (err) {\n225:         container.innerHTML = `<div class=\"alert alert-danger\">${err.message}</div>`;\n226:       } finally {\n227:         if (searchBtn) {\n228:           searchBtn.disabled = false;\n229:           searchBtn.innerHTML = '<i class=\"fas fa-search me-2\"></i>Check Prices';\n230:         }\n231:       }\n232:     }\n233:   </script>\n234: </body>\n235: </html>\n236: \nThe above content shows the entire, complete file contents of the requested file.\n"}
