le.min.js\"></script>\n187:   <script src=\"js/main.js\"></script>\n188:   <script src=\"js/auth.js\"></script>\n189:   <script>\n190:     document.addEventListener('DOMContentLoaded', async () => {\n191:       if (!enforceRoleGuard(['customer', 'admin'])) return;\n192: \n193:       const user = JSON.parse(localStorage.getItem('user') || '{}');\n194:       if (user.name) {\n195:         document.getElementById('custWelcomeName').textContent = `Welcome, ${user.name}`;\n196:       }\n197: \n198:       await loadCustomerDashboardData();\n199:     });\n200: \n201:     async function loadCustomerDashboardData() {\n202:       try {\n203:         // 1. Load History\n204:         const histRes = await fetch('/api/history', { headers: getAuthHeaders() });\n205:         const histData = await histRes.json();\n206:         const history = histData.data || [];\n207: \n208:         const verifications = history.filter(h => h.type === 'VERIFICATION');\n209:         const purchases = history.filter(h => h.type === 'PURCHASE');\n210: \n211:         document.getElementById('statCustChecked').textContent = verifications.length;\n212:         document.getElementById('statCustPurchases').textContent = purchases.length;\n213: \n214:         const histBody = document.getElementById('custRecentActivityBody');\n215:         if (history.length === 0) {\n216:           histBody.innerHTML = '<tr><td colspan=\"5\" class=\"text-center py-4 text-muted\">No recent activity. Try verifying a medicine!</td></tr>';\n217:         } else {\n218:           histBody.innerHTML = history.slice(0, 5).map(h => `\n219:             <tr>\n220:               <td>\n221:                 <strong class=\"text-navy\">${h.medicineName}</strong>\n222:                 <div class=\"small text-muted\">${h.genericName || ''}</div>\n223:               </td>\n224:               <td class=\"font-monospace small\">${h.batchNumber || 'N/A'}</td>\n225:               <td><span class=\"badge ${h.type === 'PURCHASE' ? 'bg-success' : 'bg-primary'}\">${h.type}</span></td>\n226:               <td><span class=\"status-pill match\">${h.verificationStatus}</span></td>\n227:               <td class=\"small text-muted\">${formatDate(h.checkedAt)}</td>\n228:             </tr>\n229:           `).join('');\n230:         }\n231: \n232:         // 2. Load Reports count\n233:         const rptRes = await fetch('/api/reports', { headers: getAuthHeaders() });\n234:         const rptData = await rptRes.json();\n235:         document.getElementById('statCustReports').textContent = rptData.count || 0;\n236: \n237:         // 3. Load Sales / Receipts\n238:         const salesRes = await fetch('/api/sales', { headers: getAuthHeaders() });\n239:         const salesData = await salesRes.json();\n240:         const receipts = salesData.data || [];\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
