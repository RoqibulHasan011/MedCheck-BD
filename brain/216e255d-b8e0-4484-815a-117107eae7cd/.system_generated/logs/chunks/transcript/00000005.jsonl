:     let pharmacyIdsWithMedicine = null;\n38:     if (medicineName && medicineName.trim()) {\n39:       const matchingMeds = await Medicine.find({\n40:         $or: [\n41:           { name: { $regex: medicineName.trim(), $options: 'i' } },\n42:           { genericName: { $regex: medicineName.trim(), $options: 'i' } },\n43:         ],\n44:       }).select('_id');\n45: \n46:       const medIds = matchingMeds.map((m) => m._id);\n47:       const matchingInv = await Inventory.find({\n48:         medicineId: { $in: medIds },\n49:         quantity: { $gt: 0 },\n50:       }).distinct('pharmacyId');\n51: \n52:       pharmacyIdsWithMedicine = matchingInv;\n53:       query._id = { $in: pharmacyIdsWithMedicine };\n54:     }\n55: \n56:     const pharmacies = await Pharmacy.find(query).sort({ verified: -1, name: 1 });\n57: \n58:     // Attach sample available medicines snippet to each pharmacy\n59:     const enriched = await Promise.all(\n60:       pharmacies.map(async (pharmacy) => {\n61:         const pObj = pharmacy.toObject();\n62:         const topInventory = await Inventory.find({ pharmacyId: pharmacy._id, quantity: { $gt: 0 } })\n63:           .populate('medicineId', 'name genericName')\n64:           .limit(5);\n65: \n66:         pObj.availableSampleMedicines = topInventory\n67:           .filter((inv) => inv.medicineId)\n68:           .map((inv) => inv.medicineId.name);\n69: \n70:         return pObj;\n71:       })\n72:     );\n73: \n74:     res.json({\n75:       success: true,\n76:       count: enriched.length,\n77:       data: enriched,\n78:     });\n79:   } catch (err) {\n80:     res.status(500).json({ success: false, message: err.message });\n81:   }\n82: });\n83: \n84: // @route   GET /api/pharmacies/:id\n85: // @desc    Get single pharmacy details and its active stock\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
