{"step_index":399,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T19:54:22Z","content":"Created At: 2026-09-11T01:54:22+06:00\nCompleted At: 2026-09-11T01:54:23+06:00\nFile Path: `file:///C:/Users/User/.gemini/antigravity/scratch/medcheck-bd/server/config/db.js`\nTotal Lines: 46\nTotal Bytes: 1548\nShowing lines 1 to 46\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const mongoose = require('mongoose');\n2: \n3: let mongod = null;\n4: \n5: const connectDB = async () => {\n6:   const uri = process.env.MONGODB_URI || 'mongodb://127.0.0.1:27017/medcheck_bd';\n7:   \n8:   try {\n9:     // Attempt connection to provided MongoDB URI (e.g. local or Atlas)\n10:     console.log(`[Database] Attempting connection to MongoDB at: ${uri}`);\n11:     await mongoose.connect(uri, {\n12:       serverSelectionTimeoutMS: 2500, // Quick failover if local daemon is not running\n13:     });\n14:     console.log(`[Database] Connected successfully to live MongoDB: ${mongoose.connection.host}`);\n15:   } catch (err) {\n16:     console.warn(`[Database] Live MongoDB connection failed (${err.message}).`);\n17:     console.log('[Database] Starting built-in in-memory MongoDB server for standalone zero-config operation...');\n18:     \n19:     try {\n20:       const { MongoMemoryServer } = require('mongodb-memory-server');\n21:       mongod = await MongoMemoryServer.create({\n22:         instance: {\n23:           dbName: 'medcheck_bd'\n24:         }\n25:       });\n26:       const memoryUri = mongod.getUri();\n27:       console.log(`[Database] In-memory MongoDB server running at: ${memoryUri}`);\n28:       \n29:       await mongoose.connect(memoryUri);\n30:       console.log('[Database] Connected to In-Memory MongoDB database successfully.');\n31:     } catch (memErr) {\n32:       console.error('[Database] Failed to start in-memory MongoDB fallback:', memErr.message);\n33:       process.exit(1);\n34:     }\n35:   }\n36: };\n37: \n38: const closeDB = async () => {\n39:   await mongoose.connection.close();\n40:   if (mongod) {\n41:     await mongod.stop();\n42:   }\n43: };\n44: \n45: module.exports = { connectDB, closeDB };\n46: \nThe above content shows the entire, complete file contents of the requested file.\n"}
