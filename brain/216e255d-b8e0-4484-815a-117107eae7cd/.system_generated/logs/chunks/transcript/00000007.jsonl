ry me-2\"></i>My Medicine History</h3>\n31:             <p class=\"text-muted small mb-0\">Record of verified medicines and pharmacy purchases linked to your account.</p>\n32:           </div>\n33:           <div class=\"d-flex gap-2\">\n34:             <select\n<truncated 3577 bytes>\n>\n119:             <td class=\"small text-muted\">${formatDate(item.checkedAt)}</td>\n120:             <td class=\"text-end\">\n121:               ${item.medicineId ? `\n122:                 <a href=\"medicine-details.html?id=${item.medicineId._id || item.medicineId}\" class=\"btn btn-outline-primary btn-sm py-0 px-2 me-1\">\n123:                   View\n124:                 </a>\n125:               ` : ''}\n126:               <button class=\"btn btn-outline-danger btn-sm py-0 px-2\" onclick=\"deleteHistoryItem('${item._id}')\">\n127:                 <i class=\"fas fa-trash-alt\"></i>\n128:               </button>\n129:             </td>\n130:           </tr>\n131:         `).join('');\n132:       } catch (err) {\n133:         showToast(err.message, 'danger');\n134:       }\n135:     }\n136: \n137:     async function deleteHistoryItem(id) {\n138:       try {\n139:         const res = await fetch(`/api/history/${id}`, {\n140:           method: 'DELETE',\n141:           headers: getAuthHeaders(),\n142:         });\n143:         const data = await res.json();\n144:         if (!res.ok) throw new Error(data.message);\n145: \n146:         showToast('Record deleted from history', 'info');\n147:         loadCustomerHistory();\n148:       } catch (err) {\n149:         showToast(err.message, 'danger');\n150:       }\n151:     }\n152: \n153:     async function clearAllHistory() {\n154:       if (!confirm('Are you sure you want to clear your entire medicine history?')) return;\n155: \n156:       try {\n157:         const res = await fetch('/api/history', {\n158:           method: 'DELETE',\n159:           headers: getAuthHeaders(),\n160:         });\n161:         const data = await res.json();\